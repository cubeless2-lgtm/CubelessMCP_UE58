# Publish editor-plugin sources, installation notes and non-temporary project content.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/Plugins/
/Plugins/*
!/Plugins/CubelessMCP_UE58/

# Share project content; keep owned verification assets and personal work local.
!/Content/
/Content/_MCP_Temp/
/Content/Developers/
/Content/__ExternalActors__/_MCP_Temp/
/Content/__ExternalObjects__/_MCP_Temp/
/Content/__ExternalActors__/Developers/
/Content/__ExternalObjects__/Developers/

# Optional production runner sources only; local projects/results stay ignored.
!/cubeless/
/cubeless/*
!/cubeless/tools/
!/cubeless/README.md
!/cubeless/distribution.json
!/cubeless/distribution-files.txt
!/cubeless/docs/
/cubeless/docs/*
!/cubeless/docs/*.md
!/cubeless/codex/
/cubeless/codex/*
!/cubeless/codex/AGENTS.md
!/cubeless/codex/agents/
!/cubeless/codex/policies/
!/cubeless/codex/workflows/
!/cubeless/codex/knowledge/
/cubeless/codex/agents/*
/cubeless/codex/policies/*
/cubeless/codex/workflows/*
/cubeless/codex/knowledge/*
!/cubeless/codex/knowledge/ue58-python-closure-gc.md
!/cubeless/codex/knowledge/python-candidate-compilation.md
!/cubeless/codex/agents/*.md
!/cubeless/codex/policies/*.md
!/cubeless/codex/workflows/production.md
!/cubeless/codex/workflows/packaging.md
!/cubeless/codex/workflows/migration.md
/cubeless/tools/*
!/cubeless/tools/run_pipeline.py
!/cubeless/tools/package_distribution.py
!/cubeless/tools/official_mcp_client.py
!/cubeless/tools/pipeline-requirements.txt
!/cubeless/tools/pipelines/
/cubeless/tools/pipelines/*
!/cubeless/tools/pipelines/__init__.py
!/cubeless/tools/pipelines/recorded_calls.py
!/cubeless/tools/pipelines/recorded_call_storage.py
!/cubeless/tools/pipelines/result_contracts.py
!/cubeless/tools/pipelines/production_session.py
!/cubeless/tools/pipelines/layout.py
!/cubeless/tools/pipelines/production_blueprint.py
!/cubeless/tools/pipelines/production_niagara.py
!/cubeless/tools/pipelines/production_pcg.py
!/cubeless/tools/pipelines/README.md
!/cubeless/tools/pipelines/examples/
/cubeless/tools/pipelines/examples/*
!/cubeless/tools/pipelines/examples/*.json
/AGENTS.md

# Generated build/runtime state is never distribution source.
**/Binaries/
**/Intermediate/
**/DerivedDataCache/
**/Saved/
**/__pycache__/
**/*.py[cod]
**/.venv/
**/.vs/
**/*.pdb
**/*.obj

# Development-only tests and owned verification fixture sources.
/Plugins/CubelessMCP_UE58/Content/Python/tests/
/Plugins/CubelessMCP_UE58/Source/CubelessMCPUE58Editor/Private/Tests/
/Plugins/CubelessMCP_UE58/Source/CubelessMCPUE58Editor/Private/Compatibility/UE58/DomainExpansion/CubelessDomainTests.cpp
