 for(int32 B=0;B<Ref.GetNum();++B){Names.Add(MakeShared<FJsonValueString>(Ref.GetBoneName(B).ToString()));Parents.Add(MakeShared<FJsonValueNumber>(Ref.GetParentIndex(B)));if(Model->IsValidBoneTrackName(Ref.GetBoneName(B)))Model->GetBoneTrackTransforms(Ref.GetBoneName(B),Tracks[B]);}
 Request->SetArrayField(TEXT("names"),Names);Request->SetArrayField(TEXT("parents"),Parents);
 TArray<double> P,Q,Z;for(int32 F=0;F<N;++F)for(int32 B=0;B<Ref.GetNum();++B){const FTransform T=Tracks[B].IsEmpty()?Ref.GetRefBonePose()[B]:Tracks[B][FMath::Min(F,Tracks[B].Num()-1)];const FVector V=T.GetTranslation(),S=T.GetScale3D();const FQuat R=T.GetRotation();P.Append({V.X,V.Y,V.Z});Q.Append({R.X,R.Y,R.Z,R.W});Z.Append({S.X,S.Y,S.Z});}
 Request->SetArrayField(TEXT("local_p"),Array(P));Request->SetArrayField(TEXT("local_q"),Array(Q));Request->SetArrayField(TEXT("local_s"),Array(Z));
 const auto Editable=CBMContactBones();TArray<TArray<FVector>> Samples;Samples.SetNum(Editable.Num());TArray<FTransform> Bind=Ref.GetRefBonePose();for(int32 B=1;B<Bind.Num();++B)Bind[B]=Bind[B]*Bind[Ref.GetParentIndex(B)];
 const auto* Imported=Mesh->GetImportedModel();if(!Imported||Imported->LODModels.IsEmpty()){Result=TEXT("Need target LOD0 imported skin data");return false;}
 for(const auto& Section:Imported->LODModels[0].Sections)for(const auto& V:Section.SoftVertices){int32 K=0;for(int32 J=1;J<MAX_TOTAL_INFLUENCES;++J)if(V.InfluenceWeights[J]>V.InfluenceWeights[K])K=J;if(!Section.BoneMap.IsValidIndex(V.InfluenceBones[K]))continue;int32 B=Section.BoneMap[V.InfluenceBones[K]],E=INDEX_NONE;while(B>=0&&(E=Editable.Find(Ref.GetBoneName(B)))<0)B=Ref.GetParentIndex(B);if(E>=0)Samples[E].Add(Bind[B].InverseTransformPosition(FVector(V.Position)));}
 auto Geometry=MakeShared<FJsonObject>();
 for(int32 E=0;E<Editable.Num();++E){TArray<double> V;const int32 Step=FMath::Max(1,Samples[E].Num()/1024);for(int32 I=0;I<Samples[E].Num();I+=Step){const auto& X=Samples[E][I];V.Append({X.X,X.Y,X.Z});}Geometry->SetArrayField(Editable[E].ToString(),Array(V));}
 Request->SetObjectField(TEXT("skin_samples"),Geometry);IFileManager::Get().MakeDirectory(*Dir,true);
 if(!CBMWriteJson(Dir/TEXT("request.json"),Request)){Result=TEXT("Cannot write contact request");return false;}Result=Dir/TEXT("request.json");return true;
}
