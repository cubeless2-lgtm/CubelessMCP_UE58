 Output->GetOutermost()->GetMetaData().SetValue(Output,TEXT("CubelessBodyContactSource"),*Animation->GetPathName());FSavePackageArgs Args;Args.TopLevelFlags=RF_Public|RF_Standalone;
 if(!UPackage::SavePackage(Output->GetOutermost(),Output,*FPackageName::LongPackageNameToFilename(OutputPackage,FPackageName::GetAssetPackageExtension()),Args))return Fail(TEXT("Cannot save contact result"));FAssetRegistryModule::AssetCreated(Output);Result=TEXT("Saved contact correction; all other tracks, local translations/scales and timing preserved: ")+Output->GetPathName();return Output;
}
