#include "Rendering/SkeletalMeshModel.h"
#include "Rendering/SkeletalMeshLODModel.h"
static TArray<FName> CBMContactBones(){TArray<FName> A;for(const TCHAR* S:{TEXT("l"),TEXT("r")})for(const TCHAR* B:{TEXT("thigh"),TEXT("calf"),TEXT("foot"),TEXT("upperarm"),TEXT("lowerarm"),TEXT("hand")})A.Add(FName(FString(B)+TEXT("_")+S));return A;}
bool UCubelessMocapLibrary::ExportBodyContactData(UAnimSequence* Animation,USkeletalMesh* Mesh,const FString& Directory,FString& Result){
 check(IsInGameThread());
 if(IsBusy()||(GEditor&&GEditor->PlayWorld)||!Animation||!Mesh||Animation->GetOutermost()->IsDirty()||Mesh->GetOutermost()->IsDirty()||Animation->GetSkeleton()!=Mesh->GetSkeleton()||!Animation->GetDataModel()){Result=TEXT("Need clean saved animation, matching mesh and idle editor");return false;}
 const auto* Model=Animation->GetDataModel();const auto& Ref=Mesh->GetRefSkeleton();const int32 N=Model->GetNumberOfKeys();
 if(N<2||N>3600){Result=TEXT("Expected 2..3600 samples");return false;}
 FString Dir=FPaths::ConvertRelativePathToFull(Directory);FPaths::NormalizeDirectoryName(Dir);FPaths::CollapseRelativeDirectories(Dir);
 FString Base=FPaths::ConvertRelativePathToFull(FPaths::ProjectSavedDir()/TEXT("CubelessBodyMocap"));FPaths::NormalizeDirectoryName(Base);
 if(!Dir.StartsWith(Base+TEXT("/"))||FPaths::FileExists(Dir/TEXT("request.json"))){Result=TEXT("Use a new directory below Saved/CubelessBodyMocap");return false;}
 auto Array=[](const TArray<double>& V){TArray<TSharedPtr<FJsonValue>> A;for(double X:V)A.Add(MakeShared<FJsonValueNumber>(X));return A;};
 auto Request=MakeShared<FJsonObject>();Request->SetNumberField(TEXT("version"),1);Request->SetStringField(TEXT("debug_run"),CBMDebugRun(Animation));Request->SetStringField(TEXT("source_asset"),Animation->GetPathName());Request->SetStringField(TEXT("source_guid"),Model->GenerateGuid().ToString());Request->SetStringField(TEXT("target_mesh"),Mesh->GetPathName());Request->SetNumberField(TEXT("frames"),N);Request->SetNumberField(TEXT("fps"),Model->GetFrameRate().AsDecimal());
