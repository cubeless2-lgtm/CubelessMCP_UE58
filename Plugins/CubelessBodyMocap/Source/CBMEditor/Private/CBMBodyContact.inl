  for(int32 F=0;F<int32(N);++F){double Q[4];for(int32 K=0;K<4;++K)if(!(*Values)[(F*12+B)*4+K]->TryGetNumber(Q[K])||!FMath::IsFinite(Q[K]))return Fail(TEXT("Nonfinite contact quaternion"));FQuat R(Q[0],Q[1],Q[2],Q[3]);if(FMath::Abs(R.SizeSquared()-1)>.0001||R.AngularDistance(Before[F].GetRotation())>FMath::DegreesToRadians(60.))return Fail(TEXT("Nonunit or excessive contact rotation"));Rotations[B].Add(FQuat4f(R));}}
 TGuardValue<bool> Guard(CBMExportActive,true);auto* Output=DuplicateObject<UAnimSequence>(Animation,CreatePackage(*OutputPackage),*FPackageName::GetLongPackageAssetName(OutputPackage));Output->SetFlags(RF_Public|RF_Standalone);auto& C=Output->GetController();C.OpenBracket(FText::FromString(TEXT("Target mesh body contact correction")),false);bool OK=true;
 for(int32 B=0;B<12;++B){TArray<FTransform> Keys;M->GetBoneTrackTransforms(Allowed[B],Keys);TArray<FVector3f> P,S;for(const auto& K:Keys){P.Add(FVector3f(K.GetTranslation()));S.Add(FVector3f(K.GetScale3D()));}OK=C.SetBoneTrackKeys(Allowed[B],P,Rotations[B],S,false)&&OK;}C.CloseBracket(false);if(!OK)return Fail(TEXT("Cannot apply contact tracks; unsaved output retained"));
 TArray<FName> All;M->GetBoneTrackNames(All);for(FName Bone:All){TArray<FTransform> X,Y;M->GetBoneTrackTransforms(Bone,X);Output->GetDataModel()->GetBoneTrackTransforms(Bone,Y);if(X.Num()!=Y.Num())return Fail(TEXT("Track count changed"));for(int32 F=0;F<X.Num();++F)if(!X[F].GetTranslation().Equals(Y[F].GetTranslation(),0)||!X[F].GetScale3D().Equals(Y[F].GetScale3D(),0)||(!Allowed.Contains(Bone)&&!X[F].Equals(Y[F],0)))return Fail(TEXT("Preserved track changed: ")+Bone.ToString());}
