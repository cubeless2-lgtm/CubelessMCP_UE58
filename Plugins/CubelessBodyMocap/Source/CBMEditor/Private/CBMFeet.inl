 bool OK=false;auto O=CBMReadJson(Work/TEXT("feet.json"));{FCBMStage Stage(J,TEXT("Apply pelvis/legs and verify preservation"),.9);OnGame([&](){OK=CBMBakeFeet(J,O,Message);if(OK&&J->Settings.IsValid())J->Settings->FootResult.FilePath=Work/TEXT("feet.json");});}return OK;
