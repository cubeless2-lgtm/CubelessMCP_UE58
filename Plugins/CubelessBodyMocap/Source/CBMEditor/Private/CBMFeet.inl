FString UCubelessMocapLibrary::GetFootReadiness(UCubelessMocapSettings* S){
 if(!S)return TEXT("Missing lower-body settings");
 if(!S->FootVideoLowerBody)return TEXT("Pelvis/legs: off. Enable Refine Pelvis and Legs from Video for a separate result; ankle world orientation and HandFlow hands stay unchanged.");
 if(S->FootPython.FilePath.IsEmpty()||S->FootPython.FilePath.Contains(TEXT("\""))||!FPaths::FileExists(S->FootPython.FilePath))return TEXT("Missing lower-body Python. Run Tools/prepare_lower_body.py with standalone Python 3.12, then select ThirdParty/LowerBody/venv/Scripts/python.exe. No hand runtime or weights required.");
 for(const TCHAR* Name:{TEXT("FootMRInput.json"),TEXT("FootMR_Keypoints25.f32"),TEXT("FootMR_Camera.f32")})if(!FPaths::FileExists(CBMFootData(S)/Name))return TEXT("Missing saved body observation input: ")+FString(Name)+TEXT(". Select the matching original body/hand result; body inference is not repeated.");
 if(S->FootSupportRotation&&S->FootTemporalCleanup)return TEXT("Pelvis/legs + supported feet + detected temporal foot outliers ready. Detected airborne rotations may change; other flight rotations, upper body and HandFlow are preserved. No joint limits.");
 if(S->FootSupportRotation)return TEXT("Video pelvis/legs + supported ankle/forefoot fit ready. No foot model. Support frames may rotate ankles/toes; airborne orientation, upper body and hands stay preserved. No joint limits.");
 return TEXT("Video pelvis/legs ready. No foot model inference or ankle contact rotation. Preserves ankle WORLD orientation (local counter-rotation follows the changed calf), upper-body world pose and hand-local tracks. No joint limits. Approximate fit; review before use.");
}
