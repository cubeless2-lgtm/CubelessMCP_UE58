}
bool UCubelessMocapLibrary::ApplyFootResult(UCubelessMocapSettings* S,FString& Result){
 auto J=CBMCreateFootJob(S,Result);if(!J)return false;return CBMBakeFeet(J.ToSharedRef(),CBMReadJson(S->FootResult.FilePath),Result);
}
