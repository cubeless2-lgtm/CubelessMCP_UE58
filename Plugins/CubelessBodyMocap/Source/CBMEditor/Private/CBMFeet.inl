static TSharedPtr<FCBMJob,ESPMode::ThreadSafe> CBMCreateFootJob(UCubelessMocapSettings* S,FString& Error){
 check(IsInGameThread());auto Fail=[&](const FString& M)->TSharedPtr<FCBMJob,ESPMode::ThreadSafe>{Error=M;return nullptr;};
 if(!S||!S->FootVideoLowerBody||UCubelessMocapLibrary::IsBusy()||(GEditor&&GEditor->PlayWorld))return Fail(TEXT("End the current job and PIE first."));
 auto* A=CBMFootInput(S);if(!A||!A->GetDataModel()||A->GetOutermost()->IsDirty()||!S->TargetMesh||A->GetSkeleton()!=S->TargetMesh->GetSkeleton())return Fail(TEXT("Select a saved foot input animation and matching target mesh."));
 const auto* Model=A->GetDataModel();if(Model->GetFrameRate()!=FFrameRate(30,1)||Model->GetNumberOfKeys()<2||Model->GetNumberOfKeys()>4096)return Fail(TEXT("Lower-body fitting supports 2..4096 frames at 30 FPS."));
 if(!S->OutputFolder.StartsWith(TEXT("/Game/"))||!FPackageName::IsValidLongPackageName(S->OutputFolder)||!FMath::IsFinite(S->StartSeconds)||S->StartSeconds<0||!FMath::IsFinite(S->FootGroundHeight))return Fail(TEXT("Invalid foot output/time settings."));
 auto J=MakeShared<FCBMJob,ESPMode::ThreadSafe>();J->Original.Reset(A);J->OriginalGuid=Model->GenerateGuid();J->Target.Reset(S->TargetMesh);J->Settings=S;J->FPS=30;J->FrameCount=Model->GetNumberOfKeys();J->FootGroundZ=S->FootGroundHeight;J->FootData=CBMFootData(S);J->HandPython=S->FootPython.FilePath;J->HandBackend=TEXT("VideoLegs");J->Video=FPaths::ConvertRelativePathToFull(S->Video.FilePath);J->StartSeconds=S->StartSeconds;J->OutputFolder=S->OutputFolder;J->Run=TEXT("Legs_")+FGuid::NewGuid().ToString(EGuidFormats::Digits);J->HandScript=FPaths::ConvertRelativePathToFull(IPluginManager::Get().FindPlugin(TEXT("CubelessBodyMocap"))->GetBaseDir()/TEXT("Tools/run_lower_worker.py"));
 J->FootLowerBody=true;J->FootSupportRotation=S->FootSupportRotation;J->FootTemporalCleanup=S->FootSupportRotation&&S->FootTemporalCleanup;if(!CBMPrepareFeet(J,Error))return nullptr;IFileManager::Get().MakeDirectory(*(FPaths::ProjectSavedDir()/TEXT("CubelessBodyMocap")/J->Run),true);return J;
}
bool UCubelessMocapLibrary::RefineFeet(UCubelessMocapSettings* S,FString& Result){
 if(!S||!S->FootVideoLowerBody){Result=TEXT("Enable Refine Pelvis and Legs from Video to create a separate result.");return false;}
 const FString Ready=GetFootReadiness(S);if(Ready.StartsWith(TEXT("Missing"))){Result=Ready;return false;}
 for(const auto& F:TArray<FString>{S->Video.FilePath,S->FootPython.FilePath})if(F.Contains(TEXT("\""))||!FPaths::FileExists(F)){Result=TEXT("Missing required foot file: ")+F;return false;}
 auto J=CBMCreateFootJob(S,Result);if(!J)return false;if(CurrentJob&&CurrentJob->Worker.IsValid())CurrentJob->Worker.Wait();CurrentJob=J;
