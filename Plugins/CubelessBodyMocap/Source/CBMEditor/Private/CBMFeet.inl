 if(J->FootContext){Config->SetObjectField(TEXT("contact_context"),J->FootContext.ToSharedRef());Config->SetStringField(TEXT("contact_context_signature"),J->FootContextSignature);}
 OnGame([&](){Config->SetStringField(TEXT("source_asset"),J->Original->GetPathName());});if(!CBMWriteJson(Work/TEXT("request.json"),Config)){Message=TEXT("Cannot write foot request.");return false;}
 {FCBMStage Stage(J,TEXT("Pelvis/legs worker"),.1);const FString Args=FString::Printf(TEXT("-I \"%s\" --config \"%s\""),*J->HandScript,*(Work/TEXT("request.json")));FProcHandle Proc=FPlatformProcess::CreateProc(*J->HandPython,*Args,false,true,true,nullptr,0,*Work,nullptr);if(!Proc.IsValid()){Message=TEXT("Cannot launch lower-body Python.");return false;}ON_SCOPE_EXIT{FPlatformProcess::CloseProc(Proc);};
  while(FPlatformProcess::IsProcRunning(Proc)){if(J->Cancel.Load()){FPlatformProcess::TerminateProc(Proc,true);FPlatformProcess::WaitForProc(Proc);Message=TEXT("Cancelled; original preserved.");return false;}if(auto State=CBMReadJson(Work/TEXT("worker_status.json"))){FString StageName;double Done=0;if(State->TryGetStringField(TEXT("stage"),StageName)){State->TryGetNumberField(TEXT("done"),Done);J->Update(TEXT("Legs: ")+StageName,.1+.75*Done/J->FrameCount);}}FPlatformProcess::Sleep(.1f);}
  int32 Code=-1;FPlatformProcess::GetProcReturnCode(Proc,&Code);if(Code){Message=TEXT("Lower-body fit failed; see ")+Work/TEXT("worker.log");if(auto State=CBMReadJson(Work/TEXT("worker_status.json")))State->TryGetStringField(TEXT("error"),Message);return false;}
