static UAnimSequence* CBMFootInput(UCubelessMocapSettings* S){return S->FootInputAnimation?S->FootInputAnimation.Get():S->PreviewAnimation.Get();}
static FString CBMFootData(UCubelessMocapSettings* S){
 if(!S->FootBodyData.Path.IsEmpty())return FPaths::ConvertRelativePathToFull(S->FootBodyData.Path);
 auto* A=CBMFootInput(S);if(!A)return FString();const FString Name=A->GetName();
 if(!Name.StartsWith(TEXT("Body_"))||Name.Len()<37)return FString();const FString Run=Name.Mid(5,32);
 for(TCHAR C:Run)if(!FChar::IsHexDigit(C))return FString();
