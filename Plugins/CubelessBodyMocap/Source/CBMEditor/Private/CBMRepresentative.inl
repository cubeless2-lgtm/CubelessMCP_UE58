bool UCubelessMocapLibrary::RemoveRepresentativeMarker(UCubelessMocapSettings* S,int32 Frame,FString& Result){
 check(IsInGameThread());if(S&&S->IKEnabled&&!CBMIKActive(S)){Result=TEXT("현재 결과에서 IK 편집을 먼저 시작하세요.");return false;}if(!S||IsBusy()||(GEditor&&GEditor->PlayWorld)||S->RepresentativeInput!=CBMRepresentativeInput(S)||!CBMRepresentativeFrameMap(S->RepresentativeFrames,S->RepresentativeTotalFrames)){Result=TEXT("invalid_marker_or_input");return false;}
