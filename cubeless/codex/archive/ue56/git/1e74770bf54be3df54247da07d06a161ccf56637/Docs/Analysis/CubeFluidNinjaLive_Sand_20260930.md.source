| IA_CFNL_VehicleBrake | a34158402987fb604ac086dd0f149f16900459a5f0bdc8670e4b14beb4b06f40 |
| IA_CFNL_VehicleHandbrake | 982ab79e55f114b8a2b2376203f1944d6f6f7702497d7d3be94e7284b9cc7211 |
| IA_CFNL_VehicleSteering | 836e04ab39f76bc55a8e6bda231cb8ed0eafb2098a9ddb29f2d442746a246cc6 |
| IMC_CFNL_VehicleCamera | cffbf2ea346908f524bad34f6654e76b49d63eebfc5800a6967ae4c484e1e6fb |
