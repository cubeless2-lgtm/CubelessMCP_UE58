name: verify

# Python-layer verification gates from AGENTS.md "Verification".
# C++ plugin builds stay local (UE 5.6 engine is not available on hosted
# runners); this workflow guards the Python tool layer against the class of
# regressions that py_compile alone cannot catch (see the 2026-06-21
# dependency-guard incident: three tools dead for 12 days).
#
# Runner/quota notes (repo is PRIVATE, free plan = 2000 min/month):
# - ubuntu-latest bills at 1x (windows would be 2x) and starts faster.
# - The Python layer is OS-neutral (uv-pinned CPython 3.11, no Windows-only
#   imports); Windows-specific behavior is covered by local verification.
# - Path filters keep unrelated C++/docs commits from consuming quota while
#   still running the graph-recipe contract gate for its C++ and ghost runner.

on:
  push:
    branches: [main]
    paths:
      - "Python/**"
      - "Docs/Research/niagara_asset_bootstrap_api_map.md"
      - "Docs/Tools/niagara_tools.md"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPNiagaraCommands_Part1.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPNiagaraCommands_Part7.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPNiagaraCommandsShared.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/MCPServerRunnable.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/MCPTransportWakeState.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/MCPTransportWakeState.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/MCPTransportTelemetry.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/UnrealMCPBridge.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPAICommands.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPAudioCommands.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPGASCommands.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPNetworkingCommands.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPStateTreeCommands.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/Commands/UnrealMCPAICommands.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/Commands/UnrealMCPAudioCommands.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/Commands/UnrealMCPGASCommands.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/Commands/UnrealMCPNetworkingCommands.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/Commands/UnrealMCPStateTreeCommands.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPProjectCommands.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/UnrealMCP.Build.cs"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/MCPServerRunnable.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/MCPTransportTelemetry.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/UnrealMCPBridge.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/Commands/UnrealMCPNiagaraCommands.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCPControlRigToolsEditor/Public/UnrealMCPControlRigAuthoringTypes.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCPControlRigToolsEditor/Public/UnrealMCPControlRigAuthoringSubsystem.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCPControlRigToolsEditor/Private/UnrealMCPControlRigAuthoringSubsystem.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPBlueprintNodeCommands_Part4.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPBlueprintNodeCommands_Part5.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPBlueprintNodeCommands_Part1.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPBlueprintCommands.cpp"
      - "codex/scripts/reactive_surface/niagara_scratch_pad_hlsl_to_nodes_ghost_runner.py"
      - "codex/scripts/check-project-cpp-approval-gate.ps1"
      - ".github/workflows/verify.yml"
      - ".github/workflows/verify-transport-windows.yml"
  pull_request:
    paths:
      - "Python/**"
      - "Docs/Research/niagara_asset_bootstrap_api_map.md"
      - "Docs/Tools/niagara_tools.md"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPNiagaraCommands_Part1.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPNiagaraCommands_Part7.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPNiagaraCommandsShared.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/MCPServerRunnable.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/MCPTransportWakeState.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/MCPTransportWakeState.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/MCPTransportTelemetry.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/UnrealMCPBridge.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPAICommands.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPAudioCommands.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPGASCommands.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPNetworkingCommands.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPStateTreeCommands.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/Commands/UnrealMCPAICommands.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/Commands/UnrealMCPAudioCommands.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/Commands/UnrealMCPGASCommands.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/Commands/UnrealMCPNetworkingCommands.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/Commands/UnrealMCPStateTreeCommands.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPProjectCommands.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/UnrealMCP.Build.cs"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/MCPServerRunnable.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/MCPTransportTelemetry.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/UnrealMCPBridge.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Public/Commands/UnrealMCPNiagaraCommands.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCPControlRigToolsEditor/Public/UnrealMCPControlRigAuthoringTypes.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCPControlRigToolsEditor/Public/UnrealMCPControlRigAuthoringSubsystem.h"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCPControlRigToolsEditor/Private/UnrealMCPControlRigAuthoringSubsystem.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPBlueprintNodeCommands_Part4.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPBlueprintNodeCommands_Part5.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPBlueprintNodeCommands_Part1.cpp"
      - "MCPGameProject/Plugins/UnrealMCP/Source/UnrealMCP/Private/Commands/UnrealMCPBlueprintCommands.cpp"
      - "codex/scripts/reactive_surface/niagara_scratch_pad_hlsl_to_nodes_ghost_runner.py"
      - "codex/scripts/check-project-cpp-approval-gate.ps1"
      - ".github/workflows/verify.yml"
      - ".github/workflows/verify-transport-windows.yml"

concurrency:
  group: verify-${{ github.ref }}
  cancel-in-progress: true

jobs:
  python-gates:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: Checkout (LFS pointers only; targeted fixtures below)
        uses: actions/checkout@v4
        with:
          lfs: false

      - name: Hydrate Niagara offline-gate assets
        run: |
          git lfs pull --include="MCPGameProject/Content/MCPWeather/Generated/NS_MCPWeather_UDSStyleFromScratch_Rain_20260703_V4.uasset,MCPGameProject/Content/MCPWeather/Generated/NS_MCPWeather_UDSStyleFromScratch_Snow_20260703_V4.uasset,MCPGameProject/Content/MCPWeather/FX/Rain/Materials/M_MCPWeather_Rain_Particle.uasset,MCPGameProject/Content/MCPWeather/FX/Rain/Textures/T_MCPWeather_RainSnow_Sheet.uasset,MCPGameProject/Content/MCPWeather/FX/Snow/Materials/M_MCPWeather_Snow_Particle.uasset,MCPGameProject/Content/MCPWeather/FX/Snow/Textures/T_MCPWeather_RainSnow_Sheet.uasset" --exclude=""

      - name: Install uv
        uses: astral-sh/setup-uv@v5
        with:
          enable-cache: true
          cache-dependency-glob: "Python/uv.lock"

      - name: Sync frozen Python environment
        run: uv --directory ./Python sync --frozen --python 3.11

      - name: Full offline verification profile
        run: uv --directory ./Python run python scripts/analysis/run_verification.py --profile full
