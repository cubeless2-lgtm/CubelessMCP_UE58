"""Sequence adapter/journal cases; fake engine responses are not UE verification."""

import json
import sys
import types
import unittest

import test_graph_identity_links as fixture


class SequenceTests(unittest.TestCase):
    def setUp(self):
        self.f = fixture.GraphIdentityTests()
        self.f.setUp()
        self.addCleanup(self.f.doCleanups)
        self.calls, self.checkpoints = [], []
        self.mode = "normal"
        self.unreal = sys.modules["unreal"]
        self.unreal.CubelessGraphLibrary.add_sequence_node = self.native
        self.unreal.CubelessFunctionLibrary = types.SimpleNamespace(resolve_blueprint_graph=self.resolve)

    def resolve(self, path, name, guid, kind, create):
        self.assertFalse(create)
        return json.dumps(dict(success=True, mutation_attempted=False, change_state_known=True,
            changed=False, postcondition_passed=True, compile_requested=False, compile_attempted=False,
            compiled=None, save_requested=False, save_attempted=False, saved=False,
            data={"graph": {"graph_name": "EventGraph", "object_path": fixture.GRAPH}}))

    def native(self, path, x, y, count):
        self.calls.append((path, x, y, count))
        self.checkpoints.append(self.f.state.get_operation(self.f.state._active_operation))
        value = dict(success=True, stage="complete", mutation_attempted=True,
            change_state_known=True, changed=True, postcondition_passed=True,
            compiled=False, saved=False, loaded_during_operation=False, data={})
        if self.mode == "reject":
            value.update(success=False, stage="preflight", mutation_attempted=False, changed=False,
                postcondition_passed=False, error_code="sequence_parent_unsupported", error="parent rejected")
            return json.dumps(value)
        node = fixture.Node(max(n.index for n in self.f.nodes) + 1, self.f)
        node.x, node.y = x, y
        node.get_class = lambda: types.SimpleNamespace(get_name=lambda: "K2Node_ExecutionSequence")
        fixture.Pin(node, "execute", "input", "exec")
        for index in range(count): fixture.Pin(node, "then_" + str(index), "output", "exec")
        self.f.nodes.append(node)
        if self.mode == "lost": return "{"
        if self.mode == "lost-pin": node.pins.pop()
        if self.mode == "changed-existing": self.f.nodes[0].x += 100
        value["data"] = dict(node_id=node.guid, node_guid=node.guid, object_path=node.get_path_name(), output_count=count)
        return json.dumps(value)

    def add(self, identity="sequence", **kwargs):
        return self.f.ops.add_blueprint_sequence_node("/Game/Test", operation_id=identity, **kwargs)

    def test_extra_outputs_guid_identity_shared_checkpoint_and_replay(self):
        result = self.add(node_position_json="[-40,80]", output_count=3)
        self.assertTrue(result["success"], result)
        self.assertEqual(self.calls, [(fixture.GRAPH, -40, 80, 3)])
        self.assertEqual(result["data"]["node_id"], self.f.nodes[-1].guid)
        self.assertEqual(result["data"]["object_path"], self.f.nodes[-1].get_path_name())
        self.assertTrue(result["data"]["verified_success"])
        self.assertTrue(result["data"]["postcondition_verified"])
        self.assertFalse(result["compile"]["attempted"])
        self.assertFalse(result["save"]["attempted"])
        checkpoint = self.checkpoints[0]
        self.assertGreater(checkpoint["checkpoint"]["sequence"], 0)
        self.assertFalse(checkpoint["result"]["changes"][0]["attempted"])
        self.assertEqual(len(checkpoint["result"]["data"]["before"]["nodes"]), 3)
        replay = self.add(node_position_json="[-40,80]", output_count=3)
        self.assertTrue(replay["retry"]["replayed"])
        self.assertEqual(len(self.calls), 1)

    def test_lost_response_preserves_uncertainty_and_never_dispatches_replay(self):
        self.mode = "lost"
        result = self.add()
        self.assertEqual(result["error_code"], "invalid_native_sequence_result")
        self.assertTrue(result["data"]["mutation_state_unknown"])
        self.assertTrue(result["changes"][0]["attempted"])
        self.assertEqual(len(result["data"]["before"]["nodes"]), 3)
        self.assertEqual(len(self.f.nodes), 4)
        self.assertTrue(self.add()["retry"]["replayed"])
        self.assertEqual(len(self.calls), 1)

    def test_preflight_rejection_and_strict_inputs_do_not_claim_mutations(self):
        self.mode = "reject"
        result = self.add()
        self.assertEqual(result["error_code"], "sequence_parent_unsupported")
        self.assertEqual(result["changes"], [])
        self.assertFalse(result["data"]["mutation_state_unknown"])
        for count in (True, 1, 2.5, 65):
            with self.subTest(count=count):
                invalid = self.add("invalid-" + str(count), output_count=count)
                self.assertEqual(invalid["error_code"], "sequence_output_count_invalid")
                self.assertEqual(invalid["changes"], [])
        self.assertEqual(self.add("implicit-graph", create_graph_if_missing=True)["error_code"], "sequence_graph_creation_unsupported")
        self.assertEqual(len(self.calls), 1)

    def test_successful_native_reply_cannot_hide_missing_pin_or_old_node_change(self):
        for mode in ("lost-pin", "changed-existing"):
            with self.subTest(mode=mode):
                self.mode = mode
                result = self.add(mode)
                self.assertEqual(result["error_code"], "postcondition_failed")
                self.assertFalse(result["data"]["verified_success"])
                self.assertIn("after", result["data"])
                self.assertTrue(result["changes"][0]["created"])


if __name__ == "__main__": unittest.main()
