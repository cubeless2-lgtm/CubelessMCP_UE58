"""Author a Sequence and three-gate self timer through official UE58 MCP.

The original timer_host's condition order is retained on an owned component.
External component references, inherited Tick and occupied-link replacement
remain separate migration work. This client never retries a mutation.
"""
import argparse
import hashlib
import json
from pathlib import Path
import sys
import time
import uuid

sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from official_mcp_client import OfficialMCPClient, tool_payload
from pipelines.blueprint_mutation_smoke import canonical, operation_result
from pipelines.component_authoring import PROJECT, RECORDS, SETTINGS, fingerprint, require, success, field
from pipelines.blueprint_variable_graph import TOOLSETS, graph_view, no_explicit_compile_save, graph_mutation, batch_children
from pipelines.blueprint_variables import variable_success, typed_equal
from pipelines.blueprint_function_timer import FUNCTION, MEMBER, function_success
from pipelines.blueprint_duplicate import asset_disk, asset_ref, normalized_graph, PARENT, ROOT

CALLER = "CFNL_GatedAdvance"
GATES = ("FieldResourcesReady", "PawnInside", "VisibilityInputAllowed")
DEFAULTS = {MEMBER: 0.0, "LastDelta": 0.0, **{key: False for key in GATES}}


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--endpoint", required=True)
    parser.add_argument("--expected-project", required=True, type=Path)
    parser.add_argument("--expected-pid", required=True, type=int)
    parser.add_argument("--parent-report", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args(argv)
    out, parent_path = args.output.resolve(), args.parent_report.resolve()
    require(args.expected_project.resolve() == PROJECT.resolve(), "Exact isolated project required")
    require(out.is_relative_to(RECORDS.resolve()) and not out.exists(), "Fresh report required")
    require(parent_path.is_relative_to(RECORDS.resolve()) and parent_path.is_file(), "Owned parent report required")
    parent_bytes = parent_path.read_bytes()
    parent = json.loads(parent_bytes.decode("utf-8-sig"))
    require(parent.get("schema") == "cubeless_blueprint_function_timer_v2" and parent.get("status") == "pass"
            and Path(parent["project_file"]).resolve() == PROJECT.resolve() and parent.get("official_parent") == PARENT
            and parent.get("parent_class") == "ActorComponent" and parent.get("outcome_unknown") is False,
            "Successful ActorComponent timer proof required")
    source = parent["package"]
    source_file = asset_disk(source)
    require(fingerprint(source_file) == parent["asset_file"], "Parent asset differs from proof")
    run = uuid.uuid4().hex
    package = ROOT + "/GatedTimer_" + run + "/BP_GatedTimer"
    disk = asset_disk(package)
    require(not disk.parent.exists(), "Fresh destination folder required")
    report = {"schema": "cubeless_blueprint_gated_timer_v1", "status": "running", "run_id": run,
        "project_file": str(PROJECT.resolve()), "source_package": source, "package": package,
        "parent_report": str(parent_path), "parent_report_sha256": hashlib.sha256(parent_bytes).hexdigest(),
        "source_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
        "source_file_before": fingerprint(source_file), "expected_defaults": DEFAULTS,
        "caller_function": CALLER, "gate_order": list(GATES), "stages": [], "changes": [],
        "started_ns": time.time_ns(), "automatic_retries": 0, "atomic_rollback": False, "outcome_unknown": False,
        "explicit_full_compile_requests": 0, "explicit_save_requests": 0, "cold_reload": "not_run",
        "runtime_execution": "not_run", "packaging": "not_run", "full_legacy_pipeline_parity": False,
        "scope": "Three conditions in original host order; own self call and Sequence on a cloned component. LastDelta is a test-only Sequence branch observer. A third unlinked Sequence output exercises public pin extension; the original host uses two outputs.",
        "pending": ["external generated component target", "inherited member getter", "inherited Tick", "occupied execution-link replacement", "full mouse host/reset/EndPlay"]}
    client = OfficialMCPClient(args.endpoint)
    schemas = {}

    def persist():
        out.parent.mkdir(parents=True, exist_ok=True)
        temporary = out.with_suffix(".json.partial")
        temporary.write_text(json.dumps(report, ensure_ascii=False, indent=2), encoding="utf-8")
        temporary.replace(out)

    def call(label, group, tool, arguments=None, *, mutation=False, expect_success=True):
        report["stage"] = label
        choices = [item for item in schemas[group]["tools"] if item["name"].rsplit(".", 1)[-1] == tool]
        require(len(choices) == 1, "Missing unique tool: " + tool)
        schema, mapped = choices[0]["inputSchema"], {}
        for key, value in (arguments or {}).items():
            matches = [name for name in schema.get("properties", {}) if canonical(name) == canonical(key)]
            require(len(matches) == 1, "Missing input: " + key)
            mapped[matches[0]] = value
        require(all(key in mapped for key in schema.get("required", [])), "Unexpected required argument")
        row = {"name": label, "toolset": TOOLSETS[group], "tool": tool, "arguments": mapped,
               "mutation": mutation, "state": "submitted", "started_ns": time.time_ns()}
        report["stages"].append(row)
        persist()
        try:
            row["raw"] = client.call_toolset(TOOLSETS[group], tool, mapped, mutation=mutation)
            value = operation_result(row["raw"])
            row.update(result=value, state="responded")
            if isinstance(value, dict) and "changes" in value:
                report["changes"].append({"stage": label, "observations": value["changes"]})
                row.update(compile=value.get("compile"), save=value.get("save"))
                if group == "batch":
                    report["explicit_full_compile_requests"] += sum(item.get("requested") is True for item in value.get("compile", {}).get("entries", []))
                    report["explicit_save_requests"] += sum(item.get("requested") is True for item in value.get("save", {}).get("entries", []))
                if any(item.get("change_state_known") is False for item in value["changes"]) or value.get("data", {}).get("mutation_state_unknown"):
                    report["outcome_unknown"] = True
                if value.get("data", {}).get("batch", {}).get("mutation_state_unknown"):
                    report["outcome_unknown"] = True
            if expect_success and group in {"native", "bp", "graph", "batch"}:
                success(value)
            return value
        except Exception as error:
            row["error"] = str(error)
            if mutation and row["state"] == "submitted":
                report["outcome_unknown"] = True
            raise
        finally:
            row["elapsed_seconds"] = (time.time_ns() - row["started_ns"]) / 1e9
            persist()

    def inspect(label, name, target=package):
        value = call(label, "graph", "inspect_graph", {"blueprint_name": target, "graph_name": name})
        no_explicit_compile_save(value)
        require(value["changes"] == [], "Inspection reported changes")
        graph_view(value["data"])
        return value["data"]

    def command(group, tool, **params):
        return {"type": TOOLSETS[group].rsplit(".", 1)[-1] + "." + tool, "params": {"blueprint_name": package, **params}}

    def batch(label, commands):
        value = call(label, "batch", "execute_batch", {"commands_json": json.dumps(commands), "operation_id": run + "_" + label}, mutation=True)
        return value, batch_children(value, len(commands))

    try:
        persist()
        client.initialize()
        schemas.update({key: tool_payload(client.call("describe_toolset", {"toolset_name": name})) for key, name in TOOLSETS.items()})
        report["schemas"] = schemas
        editor = call("preflight", "native", "GetEditorDiagnostics")
        require(Path(editor["project_file"]).resolve() == PROJECT.resolve() and editor["process_id"] == args.expected_pid
                and editor["engine_version"].startswith("5.8.3-") and editor["game_thread"] is True
                and not editor["pie_or_sie_active"] and editor["dirty_packages"] == [], "Wrong or dirty editor")
        report["editor"] = editor
        policy = call("save_policy", "objects", "get_properties", {"instance": {"refPath": SETTINGS}, "properties": ["SaveOnCompile"]})
        report["save_policy_before"] = policy.get("SaveOnCompile")
        require(report["save_policy_before"] == "SoC_Never", "Never is required; no setting is changed")
        require(inspect("source_timer", FUNCTION, source) == parent["saved_graph"], "Source timer graph differs")
        cloned = call("clone_unsaved", "bp", "duplicate_blueprint_to_temp", {"blueprint_name": source,
            "target_path": package, "required_root": ROOT, "dry_run": False, "compile": False, "save": False,
            "operation_id": run + "_clone"}, mutation=True)
        require(cloned["data"].get("created") is True and cloned["save"].get("saved") is False and not disk.exists(), "Clone unexpectedly saved")
        report["implicit_postduplicate_compile"] = cloned["compile"].get("implicit_postduplicate_compile")
        original_timer = inspect("cloned_timer", FUNCTION)
        original_events = inspect("cloned_events", "EventGraph")
        require(normalized_graph(original_timer, package) == normalized_graph(parent["saved_graph"], source), "Cloned timer differs")
        recursive = call("reject_direct_recursion", "graph", "add_blueprint_call_function_node", {
            "blueprint_name": package, "graph_name": FUNCTION, "graph_type": "function",
            "function_class": package + ".BP_GatedTimer_C", "function_name": FUNCTION,
            "operation_id": run + "_recursive"}, mutation=True, expect_success=False)
        require(recursive.get("success") is False and recursive.get("error_code") == "function_self_recursion_unsupported"
                and recursive.get("changes") == [] and recursive["data"]["native_outcome"]["mutation_attempted"] is False,
                "Direct recursion was not rejected before change")
        no_explicit_compile_save(recursive)
        require(inspect("recursion_unchanged", FUNCTION) == original_timer, "Rejected recursion changed the timer")
        report["direct_recursion_rejection_verified"] = True
        commands = [command("bp", "add_blueprint_variable", variable_name=key, variable_type="Boolean", default_value_json="false") for key in GATES]
        commands += [command("bp", "add_blueprint_variable", variable_name="LastDelta", variable_type="Float", default_value_json="0"),
            command("graph", "resolve_blueprint_graph", graph_name=CALLER, graph_type="function", create_if_missing=True),
            command("graph", "add_blueprint_function_parameter", graph_name=CALLER, graph_type="function", parameter_name="DeltaSeconds", parameter_type="float")]
        prepared, children = batch("prepare", commands)
        for child in children[:4]: variable_success(child)
        for child in children[4:]: function_success(child)
        entry_graph = inspect("caller_entry", CALLER)
        entry_nodes, entry_edges = graph_view(entry_graph)
        require(len(entry_nodes) == 1 and not entry_edges, "Caller entry differs")
        entry = next(iter(entry_nodes.values()))
        require(entry["class"] == "K2Node_FunctionEntry", "Missing function entry")
        commands = [command("graph", "add_blueprint_sequence_node", graph_name=CALLER, graph_type="function", output_count=3, node_position_json="[100,0]"),
            command("graph", "add_blueprint_variable_set_node", graph_name=CALLER, variable_name="LastDelta", x=300, y=-200)]
        for index, key in enumerate(GATES):
            commands += [command("graph", "add_blueprint_variable_get_node", graph_name=CALLER, variable_name=key, x=250 + 300 * index, y=200),
                         command("graph", "add_branch_node", graph_name=CALLER, x=300 + 300 * index, y=0)]
        commands += [command("graph", "add_blueprint_call_function_node", graph_name=CALLER, graph_type="function",
            function_class=package + ".BP_GatedTimer_C", function_name=FUNCTION, node_position_json="[1250,0]")]
        authored, children = batch("nodes", commands)
        # Sequence shares the graph creation core; exact result identity is independently read below.
        for child in children[:-1]: graph_mutation(child)
        function_success(children[-1])
        require(not prepared["compile"]["entries"] and not authored["compile"]["entries"]
                and not prepared["save"]["entries"] and not authored["save"]["entries"] and not disk.exists(), "Intermediate compile/save")
        before_links = inspect("caller_nodes", CALLER)
        nodes, edges = graph_view(before_links)
        require(len(nodes) == 10 and not edges, "Unexpected caller nodes/links")
        def one(predicate):
            matches = [node for node in nodes.values() if predicate(node)]
            require(len(matches) == 1, "Missing or ambiguous caller node")
            return matches[0]
        sequence = one(lambda node: node["class"] == "K2Node_ExecutionSequence")
        require({(pin["name"], pin["direction"]) for pin in sequence["pins"]}
                == {("execute", "input"), ("then_0", "output"), ("then_1", "output"), ("then_2", "output")}, "Sequence extension differs")
        marker = one(lambda node: node["class"] == "K2Node_VariableSet" and node.get("variable_name") == "LastDelta")
        advance = one(lambda node: node["class"] == "K2Node_CallFunction" and node.get("function_name") == FUNCTION)
        own_call = children[-1]["data"]
        require(advance["function_owner_path"].startswith(package + ".") and own_call["is_static"] is False
                and own_call.get("self_context") is True and own_call.get("compiled_signature_matches_skeleton") is True
                and own_call.get("function_class") == package + ".BP_GatedTimer_C"
                and own_call.get("function_path") == own_call.get("skeleton_function_path") == advance["function_path"]
                and own_call.get("compiled_function_path") == package + ".BP_GatedTimer_C:" + FUNCTION,
                "Call is not the exact own generated/current skeleton instance function")
        report["self_call"] = {key: own_call.get(key) for key in ("self_context", "function_class", "function_path",
            "compiled_function_path", "skeleton_function_path", "function_graph_guid", "compiled_signature_matches_skeleton")}
        links = [(entry, "then", sequence, "execute"), (entry, "DeltaSeconds", marker, "LastDelta"),
                 (sequence, "then_0", marker, "execute"), (entry, "DeltaSeconds", advance, "DeltaSeconds")]
        previous, previous_pin = sequence, "then_1"
        for index, key in enumerate(GATES):
            getter = one(lambda node: node["class"] == "K2Node_VariableGet" and node.get("variable_name") == key)
            branch = one(lambda node: node["class"] == "K2Node_IfThenElse" and node["x"] == 300 + 300 * index)
            links += [(getter, key, branch, "Condition"), (previous, previous_pin, branch, "execute")]
            previous, previous_pin = branch, "then"
        links += [(previous, previous_pin, advance, "execute")]
        commands = [command("graph", "connect_graph_pins", graph_name=CALLER, source_node_id=a["node_guid"],
                    source_pin_name=ap, target_node_id=b["node_guid"], target_pin_name=bp) for a, ap, b, bp in links]
        commands += [command("bp", "compile_and_save_blueprint", save=True)]
        report["planned_final_compile_save_commands"] = 1
        connected, children = batch("links_compile_save", commands)
        for child in children[:-1]: graph_mutation(child)
        compiled = children[-1]
        require(compiled["compile"].get("compiled") is True and compiled["compile"].get("error_count") == 0
                and compiled["save"].get("saved") is True and len(connected["compile"]["entries"]) == len(connected["save"]["entries"]) == 1,
                "Expected one successful explicit compile/save")
        saved = fingerprint(disk)
        require(saved is not None, "No saved asset")
        final_graph = inspect("saved_caller", CALLER)
        final_nodes, final_edges = graph_view(final_graph)
        expected_edges = set()
        for a, ap, b, bp in links:
            expected_edges |= {(a["node_id"], "output", ap, b["node_id"], bp), (b["node_id"], "input", bp, a["node_id"], ap)}
        require(final_edges == expected_edges and {key: node["node_guid"] for key, node in final_nodes.items()} == {key: node["node_guid"] for key, node in nodes.items()}, "Saved caller identity/topology differs")
        require(inspect("preserved_timer", FUNCTION) == original_timer and inspect("preserved_events", "EventGraph") == original_events, "Existing graph changed")
        require(inspect("preserved_source", FUNCTION, source) == parent["saved_graph"] and fingerprint(source_file) == report["source_file_before"], "Source changed")
        cdo = call("cdo", "official_bp", "get_default_object", {"blueprint": asset_ref(package)})
        values = call("defaults", "objects", "get_properties", {"instance": cdo, "properties": list(DEFAULTS)})
        require(all(typed_equal(field(values, key), value) for key, value in DEFAULTS.items()), "CDO defaults differ")
        final = call("final_editor", "native", "GetEditorDiagnostics")
        require(final["instance_id"] == editor["instance_id"] and final["dirty_packages"] == [] and fingerprint(disk) == saved
                and parent_path.read_bytes() == parent_bytes and not report["outcome_unknown"], "Dirty/changed/uncertain state")
        report.update(status="pass", asset_file=saved, saved_graph=final_graph, timer_graph=original_timer,
                      event_graph=original_events, expected_edges=[list(edge) for edge in sorted(expected_edges)], generated_cdo=cdo,
                      source_preserved=True, source_graph_preserved=True, sequence_outputs=3, direct_connections=len(links))
    except Exception as error:
        report.update(status="failed", error=str(error), failed_stage=report.get("stage", "discovery"), do_not_retry=True)
    finally:
        original_stage = report.get("stage")
        if report.get("save_policy_before") == "SoC_Never":
            try:
                policy = call("final_save_policy", "objects", "get_properties", {"instance": {"refPath": SETTINGS}, "properties": ["SaveOnCompile"]})
                report["save_policy_after"] = policy.get("SaveOnCompile")
                require(report["save_policy_after"] == "SoC_Never", "Save policy changed")
            except Exception as error:
                report["final_save_policy_error"] = str(error)
                if report["status"] != "failed": report.update(error=str(error), failed_stage="final_save_policy")
                report["status"] = "failed"
            finally:
                report["stage"] = original_stage
        report.update(source_file_after=fingerprint(source_file), asset_after=fingerprint(disk),
                      finished_ns=time.time_ns(), http_observations=client.observations)
        persist()
        client.close()
    print(json.dumps({key: report.get(key) for key in ("status", "package", "failed_stage", "error", "outcome_unknown")}))
    return 0 if report["status"] == "pass" else 1


if __name__ == "__main__":
    raise SystemExit(main())
