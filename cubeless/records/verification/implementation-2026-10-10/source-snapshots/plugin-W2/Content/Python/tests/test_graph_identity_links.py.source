"""Real Python graph adapters with fake native observations and pin APIs."""

import copy
import importlib
import json
from pathlib import Path
import sys
import tempfile
import types
import unittest
import uuid
from unittest.mock import patch

PACKAGE = Path(__file__).parents[1] / "cubeless_mcp_ue58"
GRAPH = "/Game/Test.Test:EventGraph"


class Node:
    def __init__(self, index, fixture):
        self.fixture, self.index, self.pins = fixture, index, []
        self.guid, self.x, self.y = f"{index:032x}", 0, 0

    def get_path_name(self): return GRAPH + ".Node" + str(self.index)
    def get_outer(self): return types.SimpleNamespace(get_path_name=lambda: GRAPH)
    def get_node_pos(self): return types.SimpleNamespace(x=self.x, y=self.y)
    def get_name(self): return "Node" + str(self.index)
    def get_class(self): return types.SimpleNamespace(get_name=lambda: "K2Node_VariableGet")
    def get_node_title(self): return self.get_name()
    def list_all_pins(self): return self.pins
    def set_node_pos(self, value): self.x, self.y = value.x, value.y


class Pin:
    def __init__(self, node, name, direction, category="number"):
        self.node, self.name, self.direction, self.category = node, name, direction, category
        self.links = []
        node.pins.append(self)

    def get_pin_name(self): return self.name
    def get_pin_direction(self): return self.direction
    def get_pin_type_as_json_schema(self): return json.dumps({"type": self.category})
    def get_pin_type_display_string(self): return self.category
    def get_pin_value(self): return ""
    def list_connected_pins(self): return self.links
    def get_owning_node(self): return self.node
    def try_create_connection(self, other):
        fixture = self.node.fixture
        fixture.connect_calls += 1
        fixture.checkpoints.append(fixture.state.get_operation(fixture.state._active_operation))
        fixture.link(self, other)
        if fixture.after_connect:
            fixture.after_connect()
        return True


class GraphIdentityTests(unittest.TestCase):
    def setUp(self):
        temporary = tempfile.TemporaryDirectory()
        self.addCleanup(temporary.cleanup)
        self.nodes, self.checkpoints = [], []
        self.connect_calls, self.identity_calls = 0, 0
        self.allow, self.exact, self.after_connect, self.refuse_delete = True, False, None, False
        self.editor = types.SimpleNamespace(list_all_nodes=lambda: self.nodes,
            get_graph=lambda: types.SimpleNamespace(get_path_name=lambda: GRAPH, get_name=lambda: "EventGraph"),
            remove_nodes=self.remove)
        native = types.SimpleNamespace(read_node_identities=self.identities, read_connection_plan=self.plan)
        modules = {"unreal": types.SimpleNamespace(CubelessGraphLibrary=native,
            EdGraphPinDirection=types.SimpleNamespace(EGPD_OUTPUT="output"), Name=lambda value: value,
            BlueprintGraphEditor=types.SimpleNamespace(get_graph_editor_by_name=lambda bp, name: self.editor),
            IntPoint=lambda x, y: types.SimpleNamespace(x=x, y=y),
            Paths=types.SimpleNamespace(project_saved_dir=lambda: temporary.name),
            SystemLibrary=types.SimpleNamespace(get_engine_version=lambda: "5.8.3-offline-test")),
            "cubeless_mcp_ue58.compatibility.ue58.blueprint": types.SimpleNamespace(resolve_blueprint=lambda name: name, ensure_editor_idle=lambda: None)}
        for suffix in ("", ".operations", ".compatibility", ".compatibility.ue58"):
            name = "cubeless_mcp_ue58" + suffix
            module = types.ModuleType(name)
            module.__path__ = [str(PACKAGE.joinpath(*suffix.strip(".").split("."))) if suffix else str(PACKAGE)]
            modules[name] = module
        self.module_patch = patch.dict(sys.modules, modules)
        self.module_patch.start(); self.addCleanup(self.module_patch.stop)
        for name in list(sys.modules):
            if name.startswith("cubeless_mcp_ue58.") and name not in modules: del sys.modules[name]
        self.api = importlib.import_module("cubeless_mcp_ue58.compatibility.ue58.graph")
        self.ops = importlib.import_module("cubeless_mcp_ue58.operations.graph")
        self.state = importlib.import_module("cubeless_mcp_ue58.operations.state")
        self.nodes.extend(Node(i, self) for i in (1, 2, 3))
        self.output = Pin(self.nodes[0], "Mass", "output")
        self.target = Pin(self.nodes[1], "Mass", "input")
        self.other = Pin(self.nodes[2], "Mass", "input")

    @staticmethod
    def native_result(**extra):
        return json.dumps(dict(success=True, mutation_attempted=False, compiled=False, saved=False,
            loaded_during_read=False, dirty_before=False, dirty_after=False, **extra))

    def identities(self, path):
        self.identity_calls += 1
        return self.native_result(total_node_count=len(self.nodes), nodes=[{"object_path": node.get_path_name(), "node_guid": node.guid,
            "variable_name": "Mass", "self_context": True, "variable_property_path": "Test_C:Mass",
            "event_name": "ReceiveBeginPlay", "event_member_parent_path": "/Script/Engine.Actor"} for node in self.nodes])

    def plan(self, *arguments):
        return self.native_result(direct_connection_allowed=self.allow, type_exactly_equal=self.exact,
            already_linked=self.target in self.output.links and self.output in self.target.links,
            schema_response_code=0 if self.allow else 4, schema_message="test")

    @staticmethod
    def link(first, second):
        first.links.append(second); second.links.append(first)

    def remove(self, nodes):
        if self.refuse_delete: return
        for node in nodes:
            self.nodes.remove(node)
            for pin in node.pins:
                for other in list(pin.links): other.links.remove(pin)
                pin.links.clear()

    def connect(self, operation_id="link"):
        return self.ops.connect_graph_pins("/Game/Test", str(uuid.UUID(self.nodes[0].guid)), "Mass",
            self.nodes[1].guid, "Mass", "EventGraph", operation_id)

    def test_native_guids_are_additive_and_graph_snapshot_reads_identity_once(self):
        data = self.api.graph_info(self.editor)
        self.assertEqual(self.identity_calls, 1)
        self.assertEqual(data["nodes"][0]["node_id"], self.nodes[0].get_path_name())
        self.assertEqual(data["nodes"][0]["node_guid"], self.nodes[0].guid)
        self.assertEqual(data["nodes"][0]["variable_property_path"], "Test_C:Mass")
        self.assertEqual(data["nodes"][0]["event_name"], "ReceiveBeginPlay")
        self.assertEqual(data["total_node_count"], 3)
        self.assertIs(self.api.find_node(self.editor, str(uuid.UUID(self.nodes[0].guid))), self.nodes[0])
        self.nodes[1].guid = self.nodes[0].guid
        with self.assertRaises(self.state.OperationError): self.api.graph_info(self.editor)

    def test_guid_delete_verifies_actual_object_absence_not_guid_string_absence(self):
        self.refuse_delete = True
        result = self.ops.delete_node("/Game/Test", self.nodes[0].guid, "EventGraph", False, "refused")
        self.assertFalse(result["success"])
        self.assertEqual(result["error_code"], "postcondition_failed")
        self.assertEqual(result["changes"][0]["node_id"], self.nodes[0].get_path_name())
        self.refuse_delete = False
        result = self.ops.delete_node("/Game/Test", self.nodes[0].guid, "EventGraph", False, "deleted")
        self.assertTrue(result["success"], result)

    def test_typed_fanout_and_different_exact_types_follow_make_and_preserve_edges(self):
        self.link(self.output, self.other)
        result = self.connect()
        self.assertTrue(result["success"], result)
        self.assertFalse(result["data"]["connection_plan"]["type_exactly_equal"])
        self.assertTrue(result["data"]["topology_preserved"])
        self.assertEqual(len(self.output.links), 2)
        self.assertEqual(self.connect_calls, 1)
        self.assertGreater(self.checkpoints[0]["checkpoint"]["sequence"], 0)
        self.assertEqual(len(self.checkpoints[0]["result"]["data"]["before"]["nodes"]), 3)
        self.assertTrue(self.connect()["retry"]["replayed"])
        self.assertEqual(self.connect_calls, 1)

    def test_existing_bidirectional_guid_link_is_noop_even_when_plan_not_make(self):
        self.link(self.output, self.target); self.allow = False
        result = self.connect()
        self.assertTrue(result["success"], result)
        self.assertEqual(result["changes"], [])
        self.assertEqual(self.connect_calls, 0)

    def test_conversion_exec_fanout_and_input_replacement_reject_before_dispatch(self):
        self.allow = False
        self.assertEqual(self.connect("conversion")["error_code"], "conversion_contract_not_implemented")
        self.allow = True; self.output.category = "exec"; self.link(self.output, self.other)
        self.assertEqual(self.connect("exec")["error_code"], "connection_would_replace_links")
        self.output.category = "number"; self.link(Pin(self.nodes[2], "Other", "output"), self.target)
        self.assertEqual(self.connect("occupied")["error_code"], "connection_would_replace_links")
        self.assertEqual(self.connect_calls, 0)

    def test_successful_api_return_does_not_hide_lost_edge_or_created_conversion_node(self):
        self.link(self.output, self.other)
        def lose_old():
            self.output.links.remove(self.other); self.other.links.remove(self.output)
        self.after_connect = lose_old
        result = self.connect("lost-edge")
        self.assertFalse(result["success"])
        self.assertFalse(result["data"]["topology_preserved"])
        self.target.links.clear(); self.output.links.clear()
        self.after_connect = lambda: self.nodes.append(Node(4, self))
        result = self.connect("extra-node")
        self.assertFalse(result["success"])
        self.assertFalse(result["data"]["topology_preserved"])

    def test_standalone_checkpoint_failure_prevents_pin_dispatch(self):
        with patch.object(self.state, "checkpoint", side_effect=self.state.OperationError("journal_checkpoint_failed", "disk failure")):
            result = self.connect()
        self.assertFalse(result["success"])
        self.assertEqual(result["error_code"], "journal_checkpoint_failed")
        self.assertEqual(self.connect_calls, 0)


if __name__ == "__main__": unittest.main()
