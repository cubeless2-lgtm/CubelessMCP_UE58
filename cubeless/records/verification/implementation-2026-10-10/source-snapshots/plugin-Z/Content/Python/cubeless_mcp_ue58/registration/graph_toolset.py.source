"""Bounded graph mutation tools for the first legacy mutation pipeline port."""

import unreal
import toolset_registry

from .results import CubelessPythonOperationResult, reflected_result
from cubeless_mcp_ue58.operations import graph


@unreal.uclass()
class CubelessBlueprintGraphTools(unreal.ToolsetDefinition):
    """Cubeless guarded K2 graph editing with object-path and GUID identities; compilation and saving are separate."""

    @toolset_registry.tool_call
    @staticmethod
    def add_blueprint_event_node(blueprint_name: str, event_name: str, node_position_json: str = "[0,0]",
            graph_name: str | None = None, graph_id: str | None = None, graph_type: str | None = None,
            create_graph_if_missing: bool = False, operation_id: str | None = None) -> CubelessPythonOperationResult:
        """Preserve the legacy named event-node contract with guarded Actor BlueprintEvent identity and actual graph readback. Supports scalar primitive inputs; object/struct/enum/container/reference/net/final/static signatures remain unsupported. An existing exact override in the selected graph is reused unchanged, including ghost state and position; no ghost promotion. Cross-graph or duplicate matches fail. No full compile/save or automatic wiring. node_id/node_guid are GUIDs; object_path is the exact node path.

        Args:
            blueprint_name: Exact /Game Blueprint package/object path or simple name under /Game/Blueprints.
            event_name: Exact native event identity such as ReceiveTick; localized titles and arbitrary custom events are not inferred.
            node_position_json: JSON [x,y] with two integers from -1000000 to 1000000. Default [0,0]; JSON null preserves legacy None as origin.
            graph_name: Optional existing graph name; omitted selects the existing default event graph.
            graph_id: Optional nonzero GUID agreeing with the selected graph.
            graph_type: Optional selector; resolved graph must be an event graph.
            create_graph_if_missing: False by default; True is explicitly unsupported before dispatch.
            operation_id: Optional durable ID; replay returns its original result and uncertain work is never retried automatically.
        """
        from cubeless_mcp_ue58.operations.events import add_blueprint_event_node
        return reflected_result(add_blueprint_event_node(blueprint_name, event_name, node_position_json,
            graph_name, graph_id, graph_type, create_graph_if_missing, operation_id))

    @toolset_registry.tool_call
    @staticmethod
    def add_blueprint_parent_function_call(blueprint_name: str, event_node_id: str, node_position_json: str = "[0,0]",
            graph_name: str | None = None, graph_id: str | None = None, graph_type: str | None = None,
            create_graph_if_missing: bool = False, operation_id: str | None = None) -> CubelessPythonOperationResult:
        """Create an explicit parent-call node for ReceiveTick in a child whose direct saved compiled Actor Blueprint parent declares its own Tick implementation and has native Actor ancestry. Other parent signatures/chains remain unsupported here. This is a new named extension, not a claimed UE56 public-tool migration. One existing exact parent-call is reused unchanged; ambiguous or mismatching nodes fail. No automatic wiring, compilation, save or fallback function. node_id/node_guid are GUIDs and object_path is the canonical path.

        Args:
            blueprint_name: Exact /Game Blueprint package/object path or simple name under /Game/Blueprints.
            event_node_id: Existing event node object path or native nonzero GUID in the selected graph. Native rechecks the exact event/parent relation.
            node_position_json: JSON [x,y], default [0,0], with integers from -1000000 to 1000000; JSON null also means origin.
            graph_name: Optional existing event graph name.
            graph_id: Optional graph GUID agreeing with graph_name/type.
            graph_type: Optional selector; the resolved graph must be an event graph.
            create_graph_if_missing: False; True is currently unsupported.
            operation_id: Optional durable replay ID; unknown results require inspection, not automatic rerun.
        """
        from cubeless_mcp_ue58.operations.events import add_blueprint_parent_function_call
        return reflected_result(add_blueprint_parent_function_call(blueprint_name, event_node_id, node_position_json,
            graph_name, graph_id, graph_type, create_graph_if_missing, operation_id))

    @toolset_registry.tool_call
    @staticmethod
    def resolve_blueprint_graph(blueprint_name: str, graph_name: str | None = None, graph_id: str | None = None,
            graph_type: str | None = None, create_if_missing: bool = False, operation_id: str | None = None) -> CubelessPythonOperationResult:
        """Resolve an existing graph, or explicitly create an exact-name function graph. Preserve legacy resolved/created/graph fields in data_json. Conflicting/ambiguous selectors and name collisions fail; never silently rename or implicitly create an EventGraph. Structural creation can regenerate the skeleton; no explicit full compile/save. All calls are journaled, so replayed reads describe the original observation.

        Args:
            blueprint_name: Runtime-safe /Game Blueprint path or simple name under /Game/Blueprints.
            graph_name: Optional exact graph name; required for function creation.
            graph_id: Optional nonzero graph GUID; must agree with other selectors. Creation with a GUID is unsupported.
            graph_type: Optional event, function, macro, delegate or any. Existing graphs are resolved within native supported bounds.
            create_if_missing: False by default. True permits only a missing named function graph, subject to native safety checks.
            operation_id: Optional durable request ID. Same normalized inputs replay; unknown outcomes never automatically retry.
        """
        from cubeless_mcp_ue58.operations.functions import resolve_blueprint_graph
        return reflected_result(resolve_blueprint_graph(blueprint_name, graph_name, graph_id, graph_type, create_if_missing, operation_id))

    @toolset_registry.tool_call
    @staticmethod
    def add_blueprint_function_parameter(blueprint_name: str, parameter_name: str, parameter_type: str,
            direction: str = "input", default_value_json: str | None = None, type_object: str | None = None,
            is_array: bool = False, graph_name: str | None = None, graph_id: str | None = None,
            graph_type: str = "function", create_graph_if_missing: bool = False,
            operation_id: str | None = None) -> CubelessPythonOperationResult:
        """Add an exact-name input parameter to an existing local function graph and verify the resulting pin. This tool preserves legacy identity: data_json.node_id and node_guid are GUIDs; object_path is the canonical node path. Existing inspect_graph/member-node tools keep node_id as an object path. Initial support is bounded scalar bool/int/int64/float/single/double/real/name/string/text; float and double remain distinct. Output parameters, arrays, referenced types and implicit graph creation are explicitly unsupported. Structural edits can regenerate the skeleton; no explicit full compile/save.

        Args:
            blueprint_name: Runtime-safe /Game Blueprint path or simple name under /Game/Blueprints.
            parameter_name: ASCII identifier of 1..100 characters; duplicates fail without automatic rename.
            parameter_type: Legacy type descriptor; unsupported descriptors fail before mutation.
            direction: Default input. Legacy output/return selectors are accepted but currently fail as unsupported before mutation.
            default_value_json: Optional strict JSON adapter for legacy Any. Omitted/null or the JSON text null means unspecified. Typed scalar defaults must satisfy native validation.
            type_object: Optional legacy type reference; nonempty values are currently unsupported.
            is_array: Default False. True is currently unsupported.
            graph_name: Existing function graph name; use resolve_blueprint_graph separately to create it.
            graph_id: Optional graph GUID that must agree with other selectors.
            graph_type: Default function; parameter authoring requires a function graph.
            create_graph_if_missing: Default False; True is currently unsupported for this action.
            operation_id: Optional durable replay ID. Partial/unknown outcomes are recorded without automatic retry.
        """
        from cubeless_mcp_ue58.operations.functions import add_blueprint_function_parameter
        return reflected_result(add_blueprint_function_parameter(blueprint_name, parameter_name, parameter_type,
            direction, default_value_json, type_object, is_array, graph_name, graph_id, graph_type, create_graph_if_missing, operation_id))

    @toolset_registry.tool_call
    @staticmethod
    def add_blueprint_call_function_node(blueprint_name: str, function_class: str, function_name: str,
            param_defaults_json: str = "{}", node_position_json: str = "[0,0]", graph_name: str | None = None,
            graph_id: str | None = None, graph_type: str | None = None, create_graph_if_missing: bool = False,
            allow_latent: bool = False, allow_editor_only: bool = False, allow_wildcard: bool = False,
            allow_deprecated: bool = False, allow_internal: bool = False,
            operation_id: str | None = None) -> CubelessPythonOperationResult:
        """Create a validated call node for an audited Engine native static function, an already compiled own function, or a compiled own function of an audited saved non-scene ActorComponent class. Typed primitive defaults and exact function/pin readback are preserved. This tool preserves legacy identity: data_json.node_id and node_guid are GUIDs; object_path is the canonical node path. Existing inspect_graph/member-node tools keep node_id as an object path. No function execution, explicit full compile or save. The older loose add_blueprint_function_node target/self inference remains a separate pending contract.

        Args:
            blueprint_name: Runtime-safe /Game Blueprint path or simple name under /Game/Blueprints.
            function_class: Exact audited /Script/Engine native static owner, the target Blueprint's own current /Game/..._C, or an exact saved clean compiled non-scene ActorComponent /Game/Package.Package_C. Generated calls require compiled own bytecode and matching skeleton signature/GUID. Own calls use self context; external component calls expose the exact generated-class self input for explicit wiring. Source loading/PostLoad may occur and scoped source/target observations are returned. SKEL/REINST inputs, inherited functions, arbitrary external classes and direct own recursion remain unsupported. Editor/MCP dependencies are forbidden; compiled/current function paths are reported separately.
            function_name: Exact UFunction name, independent of localized menu labels.
            param_defaults_json: Strict JSON object of up to 64 distinct pin names; JSON null normalizes to {} like legacy None. Native checks each supported scalar default before mutation. Unknown/unsupported pins fail. JSON adapters cap 65536 UTF-16 units, depth 8 and 1024 values; finite numbers have magnitude at most 2^53-1.
            node_position_json: JSON [x,y] of two integers from -1000000 to 1000000; default [0,0]. JSON null also normalizes to [0,0], preserving legacy None.
            graph_name: Optional existing graph name; no selector resolves the existing default event graph.
            graph_id: Optional nonzero GUID matching the selected graph.
            graph_type: Optional graph type filter agreeing with the other selectors.
            create_graph_if_missing: Default False; True is currently unsupported, so create a function graph separately.
            allow_latent: Legacy False default; True currently fails before mutation.
            allow_editor_only: Legacy False default; True is always rejected for persistent runtime assets.
            allow_wildcard: Legacy False default; True currently fails before mutation.
            allow_deprecated: Legacy False default; True currently fails before mutation.
            allow_internal: Legacy False default; True currently fails before mutation.
            operation_id: Optional durable request ID; no automatic retry or atomic rollback claim.
        """
        from cubeless_mcp_ue58.operations.functions import add_blueprint_call_function_node
        return reflected_result(add_blueprint_call_function_node(blueprint_name, function_class, function_name,
            param_defaults_json, node_position_json, graph_name, graph_id, graph_type, create_graph_if_missing,
            allow_latent, allow_editor_only, allow_wildcard, allow_deprecated, allow_internal, operation_id))

    @toolset_registry.tool_call
    @staticmethod
    def inspect_graph(blueprint_name: str, graph_name: str = "EventGraph") -> CubelessPythonOperationResult:
        """Read K2 node identities, pins, positions and links. node_id remains an object path; node_guid is a separate native GUID. Native observation caps total graph nodes at 2048 including comments; comment rows are excluded. No compile/save or forced reload.

        Args:
            blueprint_name: Full /Game Blueprint package/object path.
            graph_name: Existing graph name, defaults to EventGraph.
        """
        return reflected_result(graph.inspect_graph(blueprint_name, graph_name))

    @toolset_registry.tool_call
    @staticmethod
    def add_branch_node(blueprint_name: str, graph_name: str = "EventGraph", x: int = 0, y: int = 0, operation_id: str | None = None) -> CubelessPythonOperationResult:
        """Add a Branch node and verify class/position/existence. data_json.node_id remains its object path and node_guid contains its native GUID.

        Args:
            blueprint_name: Full /Game Blueprint package/object path.
            graph_name: Existing graph name.
            x: Node horizontal position.
            y: Node vertical position.
            operation_id: Unique durable request ID; omitted/null generates an ID returned in the result.
        """
        return reflected_result(graph.add_branch_node(blueprint_name, graph_name, x, y, operation_id))

    @toolset_registry.tool_call
    @staticmethod
    def add_blueprint_sequence_node(blueprint_name: str, node_position_json: str = "[0,0]", output_count: int = 2,
            graph_name: str | None = None, graph_id: str | None = None, graph_type: str | None = None,
            create_graph_if_missing: bool = False, operation_id: str | None = None) -> CubelessPythonOperationResult:
        """Add one standard K2 Sequence node using its exact native class and public exec-pin APIs. No localized menu lookup, implicit/explicit compile or save is requested. Verify exact class, position, execute/then_N pins and preservation of all previously observed nodes/pins/links. Native/runtime graph parent guards apply; only directly owned existing standard K2 event/function/macro graphs allowing execution flow are supported. data_json.node_id and node_guid preserve the legacy GUID identity; object_path is the canonical node path. Existing Branch/inspect node_id remains a path.

        Args:
            blueprint_name: Runtime-safe /Game Blueprint package/object path, or simple name under /Game/Blueprints.
            node_position_json: Explicit JSON adapter for legacy node_position. Defaults [0,0]; JSON null also means the origin. Exactly two integers in -1000000..1000000; malformed/nonfinite/bool values fail before mutation.
            output_count: Defaults 2. Exactly an integer 2..64; unlike the legacy internal handler, fractional inputs, values below 2 and excessive counts are rejected instead of rounded/clamped or allocated without bounds.
            graph_name: Optional exact existing graph name. No selector chooses the existing default event graph; ambiguous event graphs fail.
            graph_id: Optional nonzero graph GUID; must agree with name/type selectors.
            graph_type: Optional event, function or macro filter; delegate/custom schemas and graphs without execution flow are unsupported.
            create_graph_if_missing: False by default. True is currently unsupported; create a function graph with a separate named resolve action first. No implicit EventGraph creation.
            operation_id: Optional durable replay ID. Same normalized inputs return the recorded result. Partial/unknown native calls never automatically retry; no atomic rollback is promised.
        """
        return reflected_result(graph.add_blueprint_sequence_node(blueprint_name, node_position_json, output_count,
            graph_name, graph_id, graph_type, create_graph_if_missing, operation_id))

    @toolset_registry.tool_call
    @staticmethod
    def set_node_position(blueprint_name: str, node_id: str, x: int, y: int, graph_name: str = "EventGraph", expected_x: int | None = None, expected_y: int | None = None, operation_id: str | None = None) -> CubelessPythonOperationResult:
        """Move one K2 node, checking optional previous coordinates and reading back the final position; no compile/save.

        Args:
            blueprint_name: Full /Game Blueprint package/object path.
            node_id: Exact object-path node_id or nonzero node_guid returned by inspect_graph/add_branch_node. GUIDs resolve within the selected graph; comparisons use canonical object paths.
            x: New horizontal position.
            y: New vertical position.
            graph_name: Existing graph name.
            expected_x: If supplied, refuse when the prior x differs.
            expected_y: If supplied, refuse when the prior y differs.
            operation_id: Unique durable request ID; omitted/null generates an ID returned in the result.
        """
        return reflected_result(graph.set_node_position(blueprint_name, node_id, x, y, graph_name, expected_x, expected_y, operation_id))

    @toolset_registry.tool_call
    @staticmethod
    def delete_node(blueprint_name: str, node_id: str, graph_name: str = "EventGraph", allow_exec_linked_delete: bool = False, operation_id: str | None = None) -> CubelessPythonOperationResult:
        """Delete a K2 node and verify absence plus no dangling links. Linked exec deletion requires explicit opt-in.

        Args:
            blueprint_name: Full /Game Blueprint package/object path.
            node_id: Exact object-path node_id or nonzero node_guid returned by this Toolset. Absence and dangling-link checks use the resolved object path.
            graph_name: Existing graph name.
            allow_exec_linked_delete: Permit removing a node with connected exec pins.
            operation_id: Unique durable request ID; omitted/null generates an ID returned in the result.
        """
        return reflected_result(graph.delete_node(blueprint_name, node_id, graph_name, allow_exec_linked_delete, operation_id))

    @toolset_registry.tool_call
    @staticmethod
    def connect_graph_pins(blueprint_name: str, source_node_id: str, source_pin_name: str, target_node_id: str, target_pin_name: str, graph_name: str = "EventGraph", operation_id: str | None = None) -> CubelessPythonOperationResult:
        """Connect output/input pins only when the public K2 schema permits a direct MAKE connection. Data-output fanout is permitted; input replacement and exec-output fanout are refused. Existing bidirectional links are no-ops. Verify both directions, unchanged node identities and preservation of every prior edge. Conversion/promotion nodes remain unsupported; direct float/double compatibility is decided by the engine schema.

        Args:
            blueprint_name: Full /Game Blueprint package/object path.
            source_node_id: Output node object-path node_id or native node_guid.
            source_pin_name: Exact output pin name, such as then.
            target_node_id: Input node object-path node_id or native node_guid.
            target_pin_name: Exact input pin name, such as execute.
            graph_name: Existing graph name.
            operation_id: Unique durable request ID; omitted/null generates an ID returned in the result.
        """
        return reflected_result(graph.connect_graph_pins(blueprint_name, source_node_id, source_pin_name, target_node_id, target_pin_name, graph_name, operation_id))

    @toolset_registry.tool_call
    @staticmethod
    def connect_blueprint_graph_pins(blueprint_name: str, source_node_id: str, source_pin: str,
            target_node_id: str, target_pin: str, graph_name: str | None = None, graph_id: str | None = None,
            graph_type: str | None = None, allow_pin_link_replacement: bool = False, compile: bool = False,
            save_asset: bool = False, expected_existing_source_link_count: int | None = None,
            expected_existing_source_link_target_node_id: str | None = None,
            expected_existing_source_link_target_pin: str | None = None, expected_schema_response: str | None = None,
            operation_id: str | None = None) -> CubelessPythonOperationResult:
        """Connect existing standard K2 pins using the legacy named contract. Ordinary calls accept only direct MAKE or an existing reciprocal link. Explicit guarded replacement supports one exec source link to one exact old input and an empty new input, with current schema BREAK_OTHERS_A. Replacement requires an idle normal Blueprint, a directly owned standard K2 graph and native parent modules limited to Engine/CoreUObject. All four expected fields are required together with permission; a stale expectation fails before already-connected handling. The historical pipeline expected-field contract is restored here; the current UE56 wrapper did not expose those fields. Conversion/promotion nodes, data replacement, multiple old links, occupied new targets and compile/save remain unsupported. No atomic rollback or automatic retry. False native returns and exceptions retain independent after observations when available; lost dispatch responses remain uncertain even if a graph delta was observed.

        Args:
            blueprint_name: Runtime-safe /Game Blueprint path or simple name under /Game/Blueprints.
            source_node_id: Exact output node object path or nonzero native GUID, resolved in the selected graph.
            source_pin: Exact output pin name; legacy source_pin spelling is preserved.
            target_node_id: Exact new input node object path or nonzero native GUID.
            target_pin: Exact input pin name; legacy target_pin spelling is preserved.
            graph_name: Optional existing graph name. Omitted/empty selectors resolve the existing default event graph.
            graph_id: Optional nonzero graph GUID; must agree with other selectors.
            graph_type: Optional supported existing graph filter; no graph is created.
            allow_pin_link_replacement: False by default. True requires every expected field and the narrow exec replacement checks.
            compile: Legacy False default. True is explicitly unsupported; compile in a separate named action after graph edits succeed.
            save_asset: Legacy False default. True is explicitly unsupported; save separately after verification.
            expected_existing_source_link_count: Required with replacement permission, strict integer 1. Bool is invalid.
            expected_existing_source_link_target_node_id: Required exact old input node GUID/path; it must still be the source's sole reciprocal target.
            expected_existing_source_link_target_pin: Required old input pin name, with exactly one incoming link from this source.
            expected_schema_response: Required stable string break_others_a; localized messages are never matched.
            operation_id: Optional durable ID. Identical inputs replay the recorded result without dispatch; a new ID with stale expectations fails.

        Returns:
            data_json preserves mutation_result_v1 and endpoint fields, adds full observed before/after snapshots and directed edge deltas. Existing node GUIDs/positions and visible pin native types/defaults/unrelated links must be unchanged. Hidden pins, comments and arbitrary callbacks are outside this full-graph observation scope. Replacement guard/result fields and native endpoint observations are retained separately.
        """
        return reflected_result(graph.connect_blueprint_graph_pins(blueprint_name, source_node_id, source_pin,
            target_node_id, target_pin, graph_name, graph_id, graph_type, allow_pin_link_replacement,
            compile, save_asset, expected_existing_source_link_count, expected_existing_source_link_target_node_id,
            expected_existing_source_link_target_pin, expected_schema_response, operation_id))

    @toolset_registry.tool_call
    @staticmethod
    def add_blueprint_variable_get_node(blueprint_name: str, variable_name: str, graph_name: str = "EventGraph",
            x: int = 0, y: int = 0, operation_id: str | None = None) -> CubelessPythonOperationResult:
        """Add a getter for an own declared member, an audited generated non-scene ActorComponent in the reachable local SCS, or a readable scalar Boolean declared by a saved clean compiled Actor Blueprint ancestor. Exact skeleton property/name/native output type and declaring-parent preservation are checked. SCS GUID is separate from member-reference GUID. Other inherited/native/SCS types, external target_class variables and implicit graph creation remain unsupported. No explicit full compile or save.

        Args:
            blueprint_name: Runtime-safe /Game Blueprint package/object path or simple name under /Game/Blueprints.
            variable_name: Exact existing own member, reachable local SCS generated ActorComponent variable, or readable scalar Boolean declared on an audited generated Actor ancestor. Requires a current skeleton property; inherited setters, native inherited properties and arbitrary declared object references remain unsupported.
            graph_name: Existing supported K2 graph name, default EventGraph; legacy graph_id/type/create options remain pending.
            x: Horizontal integer position from -1000000 to 1000000. This explicit coordinate adapter replaces the legacy node_position list.
            y: Vertical integer position from -1000000 to 1000000.
            operation_id: Optional durable request ID. Same request replays its recorded result; unknown outcomes never automatically retry.
        """
        from cubeless_mcp_ue58.operations.graph_variables import add_blueprint_variable_get_node
        return reflected_result(add_blueprint_variable_get_node(blueprint_name, variable_name, graph_name, x, y, operation_id))

    @toolset_registry.tool_call
    @staticmethod
    def add_blueprint_variable_set_node(blueprint_name: str, variable_name: str, graph_name: str = "EventGraph",
            x: int = 0, y: int = 0, operation_id: str | None = None) -> CubelessPythonOperationResult:
        """Add a setter for one locally declared member variable and verify its identity/pins/position. Inherited/external target classes and implicit graph creation remain pending. No explicit full compile or save.

        Args:
            blueprint_name: Runtime-safe /Game Blueprint package/object path or simple name under /Game/Blueprints.
            variable_name: Exact existing locally declared member variable; unsupported/read-only variables fail explicitly.
            graph_name: Existing supported K2 graph name, default EventGraph.
            x: Horizontal integer position from -1000000 to 1000000; explicit adapter for legacy node_position.
            y: Vertical integer position from -1000000 to 1000000.
            operation_id: Optional durable replay ID; inspect partial/unknown changes before using a new ID.
        """
        from cubeless_mcp_ue58.operations.graph_variables import add_blueprint_variable_set_node
        return reflected_result(add_blueprint_variable_set_node(blueprint_name, variable_name, graph_name, x, y, operation_id))
