"""Failure-injection tests of real batch/core/journal Python; not UE validation."""

import ast
import contextlib
import copy
import importlib.util
import json
from pathlib import Path
import sys
import tempfile
import types
import unittest
from unittest.mock import Mock, patch


class BatchContractTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp.cleanup)
        modules = {}
        for name in ("cubeless_mcp_ue58", "cubeless_mcp_ue58.operations", "cubeless_mcp_ue58.compatibility",
                     "cubeless_mcp_ue58.compatibility.ue58"):
            module = types.ModuleType(name)
            module.__path__ = []
            modules[name] = module
        self.api = types.ModuleType("cubeless_mcp_ue58.compatibility.ue58.blueprint")
        self.api.ensure_editor_idle = Mock()
        self.api.creation_policy = Mock(return_value={"save_on_compile": "SoC_Never", "factory_implicit_compile": True})
        self.graph_api = types.ModuleType("cubeless_mcp_ue58.compatibility.ue58.graph")
        self.graph_variables_api = types.ModuleType("cubeless_mcp_ue58.compatibility.ue58.graph_variables")
        self.component_api = types.ModuleType("cubeless_mcp_ue58.compatibility.ue58.component")
        self.variables_api = types.ModuleType("cubeless_mcp_ue58.compatibility.ue58.variables")
        self.functions_api = types.ModuleType("cubeless_mcp_ue58.compatibility.ue58.functions")
        self.events_api = types.ModuleType("cubeless_mcp_ue58.compatibility.ue58.events")
        self.duplicates_api = types.ModuleType("cubeless_mcp_ue58.compatibility.ue58.blueprint_duplicates")
        self.transaction_calls = []

        @contextlib.contextmanager
        def transaction():
            self.transaction_calls.append("enter")
            try:
                yield
            finally:
                self.transaction_calls.append("exit")
        self.batch_api = types.SimpleNamespace(transaction=transaction)
        modules.update({self.api.__name__: self.api, self.graph_api.__name__: self.graph_api, self.component_api.__name__: self.component_api, self.variables_api.__name__: self.variables_api, self.graph_variables_api.__name__: self.graph_variables_api, self.functions_api.__name__: self.functions_api, self.events_api.__name__: self.events_api, self.duplicates_api.__name__: self.duplicates_api,
                        "cubeless_mcp_ue58.compatibility.ue58.batch": self.batch_api,
                        "unreal": types.SimpleNamespace(Paths=types.SimpleNamespace(project_saved_dir=lambda: self.temp.name),
                            SystemLibrary=types.SimpleNamespace(get_engine_version=lambda: "5.8.3-offline-test"))})
        modules["cubeless_mcp_ue58.compatibility.ue58"].blueprint = self.api
        modules["cubeless_mcp_ue58.compatibility.ue58"].graph = self.graph_api
        modules["cubeless_mcp_ue58.compatibility.ue58"].graph_variables = self.graph_variables_api
        modules["cubeless_mcp_ue58.compatibility.ue58"].component = self.component_api
        modules["cubeless_mcp_ue58.compatibility.ue58"].variables = self.variables_api
        modules["cubeless_mcp_ue58.compatibility.ue58"].functions = self.functions_api
        modules["cubeless_mcp_ue58.compatibility.ue58"].events = self.events_api
        modules["cubeless_mcp_ue58.compatibility.ue58"].blueprint_duplicates = self.duplicates_api
        modules["cubeless_mcp_ue58.compatibility.ue58"].batch = self.batch_api
        self.module_patch = patch.dict(sys.modules, modules)
        self.module_patch.start()
        self.addCleanup(self.module_patch.stop)
        self.state = self.load("state")
        self.blueprint = self.load("blueprint")
        self.graph = self.load("graph")
        self.graph_variables = self.load("graph_variables")
        self.component = self.load("component")
        self.variables = self.load("variables")
        self.functions = self.load("functions")
        self.events = self.load("events")
        self.duplicates = self.load("blueprint_duplicates")
        self.batch = self.load("batch")
        self.assets = {}
        self.calls = []
        self.api.new_asset_path = lambda name, package: (package or "/Game/Blueprints") + "/" + name
        self.api.asset_subsystem = lambda: types.SimpleNamespace(
            does_asset_exist=lambda path: path in self.assets, does_directory_exist=lambda path: False)
        self.api.resolve_parent = lambda name: (name, ["/Script/Engine.Actor"])

        def create_asset(name, package_path, blueprint_class, factory):
            path = package_path + "/" + name
            self.calls.append(("create", path))
            asset = types.SimpleNamespace(get_path_name=lambda: path + "." + name)
            self.assets[path] = asset
            return asset

        self.factory_create = Mock(side_effect=create_asset)
        # Exercise the real compatibility dispatch boundary with a fake engine,
        # including its second policy check and pre/post factory observations.
        path = Path(__file__).parents[1] / "cubeless_mcp_ue58/compatibility/ue58/blueprint.py"
        definition = next(node for node in ast.parse(path.read_text(encoding="utf-8-sig")).body
                          if isinstance(node, ast.FunctionDef) and node.name == "create")
        namespace = {"creation_policy": lambda: self.api.creation_policy(), "unreal": types.SimpleNamespace(
            BlueprintFactory=Mock, Blueprint=types.SimpleNamespace(static_class=lambda: object),
            AssetToolsHelpers=types.SimpleNamespace(get_asset_tools=lambda: types.SimpleNamespace(create_asset=self.factory_create)))}
        exec(compile(ast.Module(body=[definition], type_ignores=[]), str(path), "exec"), namespace)

        def resolve(path):
            if path not in self.assets:
                raise self.state.OperationError("blueprint_not_found", path)
            return self.assets[path]
        self.api.create = namespace["create"]
        self.api.resolve_blueprint = resolve
        self.api.snapshot = lambda asset: {"asset_path": asset.get_path_name(), "status": "synthetic"}

        def compile_validation(asset, save, refresh):
            self.calls.append(("compile", asset.get_path_name(), save, refresh))
            return {"mutation_performed": True, "compiled": True, "saved": save, "refreshed_nodes": refresh,
                    "validation_pass": True, "status": "up_to_date", "compile_error_count": 0, "compile_warning_count": 0}
        self.api.compile_validation = compile_validation
        self.component_calls = []

        def component_mutation(**arguments):
            self.component_calls.append(arguments)
            compile_requested = arguments.get("compile_blueprint", False)
            return {"success": True, "stage": "complete", "data": {"component_name": arguments["component_name"]},
                "mutation_attempted": True, "change_state_known": True, "changed": True, "postcondition_passed": True,
                "compile_requested": compile_requested, "compile_attempted": compile_requested,
                "compiled": True if compile_requested else None, "save_requested": False, "saved": False}
        self.component_api.add_component_to_blueprint = component_mutation
        self.component_api.set_component_property = component_mutation
        self.component_api.set_physics_properties = component_mutation
        self.component_api.set_static_mesh_properties = component_mutation
        self.component_read_calls = []

        def component_read(*arguments):
            self.component_read_calls.append(arguments)
            return {"success": True, "stage": "complete", "data": {"property_value": False},
                "mutation_attempted": False, "change_state_known": True, "changed": False, "postcondition_passed": True,
                "compile_requested": False, "save_requested": False, "saved": False, "loaded_during_read": False, "auto_retry_safe": True}
        self.component_api.get_component_property = component_read
        self.component_api.list_blueprint_components = component_read

    def test_duplicate_named_defaults_share_action_without_nested_journal(self):
        name = "CubelessBlueprintTools.duplicate_blueprint_to_temp"
        self.assertIs(self.batch._CAPABILITIES[name]["action"], self.duplicates.duplicate_blueprint_to_temp_action)
        normalized = self.batch._normalize(json.dumps([{"type": name, "params": {
            "blueprint_name": "/Game/BP_Source", "target_path": "/Game/_MCP_Temp/BP_Clone"}}]), True)
        self.assertEqual(normalized[0]["params"], {"blueprint_name": "/Game/BP_Source", "target_path": "/Game/_MCP_Temp/BP_Clone",
            "required_root": "/Game/_MCP_Temp", "dry_run": True, "overwrite_existing": False,
            "allow_dirty_source": False, "compile": False, "save": True})

    def test_function_actions_share_one_journal_and_final_compile(self):
        calls = []

        def native(**arguments):
            calls.append(arguments)
            self.assertGreater(self.state.get_operation("test-batch")["checkpoint"]["sequence"], 0)
            return {"success": True, "stage": "complete", "data": {"graph": {"graph_name": "Timer"}},
                "mutation_attempted": True, "changed": True, "change_state_known": True, "postcondition_passed": True,
                "compile_requested": False, "compile_attempted": False, "compiled": None,
                "save_requested": False, "save_attempted": False, "saved": False}
        self.functions_api.resolve_blueprint_graph = native
        self.functions_api.add_blueprint_function_parameter = native
        self.functions_api.add_blueprint_call_function_node = native
        common = {"blueprint_name": "BP_Test", "graph_name": "Timer", "graph_type": "function"}
        commands = [self.create_entry(),
            {"type": "CubelessBlueprintGraphTools.resolve_blueprint_graph", "params": {**common, "create_if_missing": True}},
            {"type": "CubelessBlueprintGraphTools.add_blueprint_function_parameter", "params": {
                **common, "parameter_name": "Delta", "parameter_type": "Float", "default_value_json": "0.5"}},
            {"type": "CubelessBlueprintGraphTools.add_blueprint_call_function_node", "params": {
                **common, "function_class": "/Script/Engine.KismetMathLibrary", "function_name": "Abs"}}, self.compile_entry()]
        result = self.execute(commands)
        self.assertTrue(result["success"], result)
        self.assertEqual(len(calls), 3)
        self.assertEqual(calls[1]["default_value_json"], "0.5")
        self.assertEqual(calls[2]["node_position_json"], "[0,0]")
        self.assertEqual(sum(call[0] == "compile" for call in self.calls), 1)
        self.assertEqual(len(list(self.state._journal_path("test-batch").parent.glob("*.json"))), 1)
        self.assertTrue(self.execute(commands)["retry"]["replayed"])
        self.assertEqual(len(calls), 3)

    def test_variable_actions_share_one_journal_and_one_final_compile(self):
        variable_calls = []

        def native(**arguments):
            variable_calls.append(arguments)
            return {"success": True, "stage": "complete", "data": {"variable_name": arguments.get("variable_name")},
                "mutation_attempted": True, "change_state_known": True, "changed": True, "postcondition_passed": True,
                "compile_requested": arguments.get("compile", False), "compile_attempted": False, "compiled": None,
                "save_requested": arguments.get("save", False), "save_attempted": False, "saved": False}
        self.variables_api.add_blueprint_variable = native
        self.variables_api.set_blueprint_variable_default = native
        self.variables_api.inspect_blueprint_variables = lambda **arguments: dict(native(**arguments), mutation_attempted=False, changed=False)
        commands = [self.create_entry(), {"type": "CubelessBlueprintTools.add_blueprint_variable", "params": {
            "blueprint_name": "BP_Test", "variable_name": "Mass", "variable_type": "Float", "default_value_json": "10"}},
            {"type": "CubelessBlueprintTools.set_blueprint_variable_default", "params": {
                "blueprint_name": "BP_Test", "variable_name": "Mass", "default_value_json": "25", "compile": False, "save": False}},
            {"type": "CubelessBlueprintTools.inspect_blueprint_variables", "params": {"blueprint_name": "BP_Test"}}, self.compile_entry()]
        result = self.execute(commands)
        self.assertTrue(result["success"], result)
        self.assertEqual(len(variable_calls), 3)
        self.assertEqual(variable_calls[0]["default_value_json"], "10")
        self.assertFalse(variable_calls[1]["compile"])
        self.assertTrue(result["data"]["batch"]["results"][3]["response"]["data"]["journaled"])
        self.assertEqual(sum(call[0] == "compile" for call in self.calls), 1)
        self.assertEqual(len(list(self.state._journal_path("test-batch").parent.glob("*.json"))), 1)
        self.assertTrue(self.execute(commands)["retry"]["replayed"])
        self.assertEqual(len(variable_calls), 3)

    def test_variable_lost_response_stops_batch_with_unknown_compile_and_save(self):
        self.variables_api.set_blueprint_variable_default = Mock(side_effect=RuntimeError("reply lost"))
        entry = {"type": "CubelessBlueprintTools.set_blueprint_variable_default", "params": {
            "blueprint_name": "BP_Test", "variable_name": "Mass", "default_value_json": "25"}}
        result = self.execute([entry, self.create_entry()], stop=False)
        summary = result["data"]["batch"]
        self.assertTrue(summary["forced_stop"])
        self.assertTrue(summary["mutation_state_unknown"])
        self.assertEqual(summary["not_run"], [1])
        child = summary["results"][0]["response"]
        self.assertIsNone(child["compile"]["attempted"])
        self.assertIsNone(child["save"]["saved"])
        self.assertEqual(self.calls, [])

    def load(self, name):
        fullname = "cubeless_mcp_ue58.operations." + name
        path = Path(__file__).parents[1] / "cubeless_mcp_ue58/operations" / (name + ".py")
        spec = importlib.util.spec_from_file_location(fullname, path)
        module = importlib.util.module_from_spec(spec)
        sys.modules[fullname] = module
        spec.loader.exec_module(module)
        setattr(sys.modules["cubeless_mcp_ue58.operations"], name, module)
        return module

    def create_entry(self, name="BP_Test"):
        return {"type": "CubelessBlueprintTools.create_blueprint", "params": {"name": name, "parent_class": "Actor"}}

    def test_autosave_policy_rejects_standalone_before_factory_or_change_intent(self):
        for mode in ("SoC_Always", "SoC_SuccessOnly"):
            with self.subTest(mode=mode):
                self.api.creation_policy.side_effect = self.state.OperationError("creation_autosave_policy_unsupported", mode)
                result = self.blueprint.create_blueprint("BP_" + mode, "Actor", operation_id=mode)
                self.assertFalse(result["success"])
                self.assertEqual(result["error_code"], "creation_autosave_policy_unsupported")
                self.assertEqual(result["changes"], [])
                self.assertFalse(result["save"]["attempted"])
                self.assertEqual(self.calls, [])
                self.assertEqual(self.assets, {})

    def test_autosave_policy_rejects_batch_before_factory(self):
        self.api.creation_policy.side_effect = self.state.OperationError("creation_autosave_policy_unsupported", "SoC_Always")
        result = self.execute([self.create_entry(), self.compile_entry()])
        self.assertFalse(result["success"])
        self.assertEqual(self.calls, [])
        self.assertEqual(self.assets, {})

    def test_creation_records_implicit_factory_compile_separately(self):
        result = self.blueprint.create_blueprint("BP_Test", "Actor", operation_id="creation-implicit-compile")
        self.assertTrue(result["success"])
        self.assertFalse(result["compile"]["requested"])
        self.assertTrue(result["compile"]["implicit_factory_compile"]["attempted"])
        self.assertFalse(result["compile"]["implicit_factory_compile"]["diagnostics_captured"])
        self.assertFalse(result["save"]["saved"])

    def test_second_policy_rejection_records_factory_not_called(self):
        self.api.creation_policy.side_effect = [self.api.creation_policy.return_value,
            self.state.OperationError("creation_autosave_policy_unsupported", "SoC_Always")]
        result = self.blueprint.create_blueprint("BP_Test", "Actor", operation_id="second-policy-rejection")
        self.assertEqual(result["error_code"], "creation_autosave_policy_unsupported")
        self.assertEqual(result["changes"], [])
        self.assertFalse(result["compile"]["implicit_factory_compile"]["attempted"])
        self.assertFalse(result["compile"]["implicit_factory_compile"]["factory_call_attempted"])
        self.factory_create.assert_not_called()

    def test_factory_exception_preserves_unknown_implicit_compile(self):
        create_asset = self.factory_create.side_effect
        def create_then_fail(*args):
            create_asset(*args)
            raise RuntimeError("engine effect followed by lost factory response")
        self.factory_create.side_effect = create_then_fail
        result = self.blueprint.create_blueprint("BP_Test", "Actor", operation_id="factory-response-lost")
        implicit = result["compile"]["implicit_factory_compile"]
        self.assertFalse(result["success"])
        self.assertTrue(implicit["factory_call_attempted"])
        self.assertFalse(implicit["factory_returned"])
        self.assertIsNone(implicit["attempted"])
        self.assertIsNone(result["changes"][0]["created"])
        self.assertIn("/Game/Blueprints/BP_Test", self.assets)
        self.assertFalse(result["retry"]["automatic_retry"])

    def inspect_entry(self, path="/Game/Blueprints/BP_Test"):
        return {"type": "CubelessBlueprintTools.inspect_blueprint", "params": {"blueprint_name": path}}

    def compile_entry(self, name="compile_and_save_blueprint", **params):
        return {"type": "CubelessBlueprintTools." + name, "params": {"blueprint_name": "/Game/Blueprints/BP_Test", **params}}

    def execute(self, entries, stop=True, operation_id="test-batch"):
        return self.batch.execute_batch(json.dumps(entries), stop, operation_id)

    def test_create_compile_and_read_follow_order_use_one_journal_and_no_nested_gate(self):
        result = self.execute([self.create_entry(), self.compile_entry(), self.inspect_entry()])
        self.assertTrue(result["success"], result)
        summary = result["data"]["batch"]
        self.assertEqual((summary["total"], summary["executed"], summary["dispatched_count"], summary["succeeded"]), (3, 3, 3, 3))
        self.assertEqual(summary["not_run"], [])
        self.assertEqual(self.calls, [("create", "/Game/Blueprints/BP_Test"), ("compile", "/Game/Blueprints/BP_Test.BP_Test", True, False)])
        self.assertEqual(self.transaction_calls, ["enter", "exit"])
        self.assertEqual(len(list(self.state._journal_path("test-batch").parent.glob("*.json"))), 1)
        self.assertEqual(len(result["save"]["entries"]), 1)
        self.assertTrue(result["save"]["saved"])
        self.assertGreaterEqual(summary["checkpoint_sequence"], 8)

    def test_unsupported_last_command_rejects_before_prefix_write(self):
        result = self.execute([self.create_entry(), {"type": "execute_python", "params": {"code": "bad"}}])
        self.assertEqual(result["error_code"], "batch_unsupported_command")
        self.assertEqual(self.calls, [])
        self.assertFalse(self.state._journal_path("test-batch").exists())

    def test_admission_strict_types_unknown_arguments_and_nesting(self):
        invalid = [
            ({"type": "CubelessBlueprintGraphTools.add_branch_node", "params": {"blueprint_name": "/Game/Test", "x": True}}, "batch_invalid_parameter_type"),
            ({"type": "CubelessBlueprintGraphTools.add_branch_node", "params": {"blueprint_name": "/Game/Test", "x": 2**32}}, "batch_parameter_out_of_range"),
            ({"type": "CubelessBlueprintTools.inspect_blueprint", "params": {"blueprint_name": "x", "operation_id": "child"}}, "batch_unknown_parameter"),
            ({"type": "batch"}, "batch_nested"),
            ({"type": "CubelessBatchTools.execute_batch"}, "batch_nested"),
            ({"type": "CubelessBlueprintTools.inspect_blueprint", "params": None}, "batch_missing_parameter"),
        ]
        for entry, code in invalid:
            with self.subTest(code=code):
                result = self.execute([self.create_entry(), entry])
                self.assertEqual(result["error_code"], code)
                self.assertEqual(self.calls, [])

    def test_duplicate_json_keys_and_nonfinite_constants_are_rejected(self):
        for data, code in [('[{"type":"a","type":"b"}]', "batch_duplicate_key"), ('[NaN]', "batch_invalid_json")]:
            self.assertEqual(self.batch.execute_batch(data)["error_code"], code)
        self.assertEqual(self.execute([])["error_code"], "batch_invalid_commands")
        self.assertEqual(self.execute([self.inspect_entry()] * 101)["error_code"], "batch_too_large")

    def test_known_failure_stop_true_preserves_created_prefix(self):
        result = self.execute([self.create_entry(), self.create_entry(), self.create_entry("BP_After")])
        summary = result["data"]["batch"]
        self.assertFalse(result["success"])
        self.assertEqual((summary["executed"], summary["failed"], summary["stopped_at_index"]), (2, 1, 1))
        self.assertEqual(summary["not_run"], [2])
        self.assertTrue(summary["partial_mutation"])
        self.assertFalse(summary["forced_stop"])
        self.assertEqual(len(self.calls), 1)

    def test_known_failure_false_continues_but_overall_fails(self):
        result = self.execute([self.create_entry(), self.create_entry(), self.create_entry("BP_After")], stop=False)
        summary = result["data"]["batch"]
        self.assertFalse(result["success"])
        self.assertEqual((summary["executed"], summary["succeeded"], summary["failed"]), (3, 2, 1))
        self.assertEqual(summary["stopped_at_index"], -1)
        self.assertEqual(summary["not_run"], [])
        self.assertEqual(len(self.calls), 2)

    def test_successful_engine_write_then_readback_failure_forces_stop_even_false(self):
        self.api.snapshot = Mock(side_effect=RuntimeError("readback broken after creation"))
        result = self.execute([self.create_entry(), self.create_entry("BP_After")], stop=False)
        summary = result["data"]["batch"]
        self.assertEqual(len(self.calls), 1)
        self.assertTrue(summary["forced_stop"])
        self.assertTrue(summary["mutation_state_unknown"])
        self.assertTrue(summary["mutation_performed"])
        self.assertEqual(summary["results"][0]["response"]["stage"], "readback")
        self.assertTrue(result["changes"][0]["created"])
        self.assertFalse(result["retry"]["automatic_retry"])
        implicit = summary["results"][0]["response"]["compile"]["implicit_factory_compile"]
        self.assertTrue(implicit["factory_call_attempted"])
        self.assertTrue(implicit["factory_returned"])
        self.assertTrue(implicit["attempted"])
        self.assertIsNone(implicit["engine_status"])
        self.assertFalse(implicit["diagnostics_captured"])

    def test_native_compile_failure_has_known_effect_and_false_can_continue(self):
        self.api.compile_validation = Mock(return_value={"mutation_performed": True, "compiled": False, "saved": False,
            "validation_pass": False, "status": "error", "stage": "compile", "error_code": "blueprint_compile_failed", "error": "bad graph"})
        result = self.execute([self.create_entry(), self.compile_entry(), self.inspect_entry()], stop=False)
        summary = result["data"]["batch"]
        self.assertFalse(result["success"])
        self.assertEqual(summary["executed"], 3)
        self.assertFalse(summary["mutation_state_unknown"])
        self.assertFalse(result["save"]["attempted"])
        self.assertFalse(result["save"]["saved"])

    def test_save_failure_retains_compile_outcome_and_requested_save(self):
        self.api.compile_validation = Mock(return_value={"mutation_performed": True, "compiled": True, "saved": False,
            "validation_pass": True, "status": "up_to_date"})
        result = self.execute([self.create_entry(), self.compile_entry()])
        self.assertFalse(result["success"])
        self.assertTrue(result["compile"]["entries"][0]["compiled"])
        self.assertTrue(result["save"]["requested"])
        self.assertTrue(result["save"]["attempted"])
        self.assertFalse(result["save"]["saved"])

    def test_compile_wrappers_preserve_distinct_defaults(self):
        result = self.execute([self.create_entry(), self.compile_entry("compile_blueprint"),
                               self.compile_entry("compile_and_validate_blueprint")])
        self.assertTrue(result["success"])
        self.assertEqual([c[2:] for c in self.calls if c[0] == "compile"], [(False, False), (False, True)])
        self.assertFalse(result["save"]["requested"])

    def test_normalized_default_replay_never_runs_again_and_conflict_rejected(self):
        first = self.execute([self.create_entry()])
        self.assertTrue(first["success"])
        explicit = self.create_entry()
        explicit["params"]["package_path"] = "/Game/Blueprints"
        replay = self.execute([explicit])
        self.assertTrue(replay["retry"]["replayed"])
        self.assertEqual(len(self.calls), 1)
        self.assertEqual(self.execute([self.create_entry("Other")])["error_code"], "operation_id_conflict")

    def test_existing_mutation_gate_remains_nonreentrant(self):
        self.state._active_operation = "other-owner"
        result = self.execute([self.create_entry()])
        self.assertEqual(result["error_code"], "mutation_busy")
        self.assertEqual(self.calls, [])
        self.assertEqual(self.state._active_operation, "other-owner")

    def test_crash_after_api_write_keeps_durable_intent_and_blocks_replay(self):
        original = self.api.create
        def crash(*args):
            original(*args)
            raise KeyboardInterrupt("process terminated after engine effect")
        self.api.create = crash
        commands = [self.create_entry(), self.create_entry("BP_After")]
        with self.assertRaises(KeyboardInterrupt):
            self.execute(commands)
        self.assertEqual(len(self.calls), 1)
        record = self.state.get_operation("test-batch")
        self.assertEqual(record["state"], "started")
        self.assertEqual(record["journal_observation"]["recorded_result_scope"], "last_durable_checkpoint")
        self.assertEqual(record["journal_observation"]["actual_changes"], "unknown")
        self.assertEqual(record["result"]["data"]["batch"]["results"][0]["phase"], "mutation_intent")
        self.assertEqual(self.execute(commands)["error_code"], "operation_incomplete")
        self.assertEqual(len(self.calls), 1)
        self.assertIsNone(self.state._active_operation)

    def test_checkpoint_disk_failure_before_engine_call_preserves_no_dispatch(self):
        real = self.batch.checkpoint
        def checkpoint(result):
            if result["stage"].endswith(":before:create"):
                raise self.state.OperationError("journal_checkpoint_failed", "disk full")
            return real(result)
        with patch.object(self.batch, "checkpoint", side_effect=checkpoint):
            result = self.execute([self.create_entry(), self.create_entry("BP_After")], stop=False)
        self.assertEqual(self.calls, [])
        summary = result["data"]["batch"]
        self.assertTrue(summary["forced_stop"])
        self.assertFalse(summary["mutation_attempted"])
        self.assertFalse(summary["mutation_performed"])
        self.assertFalse(result["changes"][0]["attempted"])
        self.assertTrue(result["changes"][0]["intent_prepared"])
        self.assertEqual(summary["not_run"], [1])

    def test_result_checkpoint_failure_after_effect_stops_no_later_action(self):
        real = self.batch.checkpoint
        def checkpoint(result):
            if result["stage"] == "batch[0]:result":
                raise self.state.OperationError("journal_checkpoint_failed", "disk full after effect")
            return real(result)
        with patch.object(self.batch, "checkpoint", side_effect=checkpoint):
            result = self.execute([self.create_entry(), self.create_entry("BP_After")], stop=False)
        self.assertEqual(len(self.calls), 1)
        self.assertFalse(result["success"])
        self.assertTrue(result["data"]["batch"]["forced_stop"])
        self.assertTrue(result["data"]["batch"]["mutation_performed"])

    def test_finalize_failure_does_not_return_success_or_allow_replay(self):
        real = self.state._write_record
        def write(path, record):
            if record["state"] == "complete":
                raise OSError("finalize failed")
            return real(path, record)
        with patch.object(self.state, "_write_record", side_effect=write):
            result = self.execute([self.create_entry()])
        self.assertEqual(result["error_code"], "journal_finalize_failed")
        self.assertFalse(result["success"])
        self.assertFalse(result["data"]["batch"]["success"])
        self.assertEqual(self.execute([self.create_entry()])["error_code"], "operation_incomplete")
        self.assertEqual(len(self.calls), 1)

    def test_read_only_batch_uses_no_transaction_and_replay_is_historical(self):
        self.api.create("BP_Test", "/Game/Blueprints/BP_Test", "Actor")
        result = self.execute([self.inspect_entry()])
        self.assertTrue(result["success"])
        self.assertFalse(result["data"]["batch"]["mutation_attempted"])
        self.assertEqual(self.transaction_calls, [])
        self.api.snapshot = Mock(side_effect=RuntimeError("must not inspect on replay"))
        replay = self.execute([self.inspect_entry()])
        self.assertTrue(replay["success"])
        self.assertTrue(replay["retry"]["replayed"])
        self.api.snapshot.assert_not_called()

    def test_budget_checked_between_actions_never_claims_engine_cancellation(self):
        with patch.object(self.batch, "BETWEEN_STEP_BUDGET_SECONDS", 0):
            result = self.execute([self.create_entry(), self.create_entry("BP_After")])
        summary = result["data"]["batch"]
        self.assertEqual(len(self.calls), 1)
        self.assertFalse(result["success"])
        self.assertEqual(summary["stop_reason"], "between_step_time_budget")
        self.assertTrue(summary["partial_mutation"])
        self.assertFalse(summary["limits"]["engine_call_preemption"])

    def test_in_flight_marker_forces_failure_even_if_child_claims_success(self):
        capability = self.batch._CAPABILITIES["CubelessBlueprintTools.inspect_blueprint"]
        def unsafe_response(result, **kwargs):
            result["success"] = True
            result["data"]["command_may_still_be_in_flight"] = True
        with patch.dict(capability, action=unsafe_response):
            result = self.execute([self.inspect_entry(), self.create_entry()], stop=False)
        self.assertFalse(result["success"])
        self.assertTrue(result["data"]["batch"]["command_may_still_be_in_flight"])
        self.assertTrue(result["data"]["batch"]["mutation_state_unknown"])
        self.assertEqual(self.calls, [])

    def test_capability_parameters_and_defaults_match_registered_individual_tools(self):
        base = Path(__file__).parents[1] / "cubeless_mcp_ue58/registration"
        checked = set()
        for filename in ("toolsets.py", "graph_toolset.py", "component_toolset.py"):
            tree = ast.parse((base / filename).read_text(encoding="utf-8-sig"))
            for cls in (item for item in tree.body if isinstance(item, ast.ClassDef)):
                for function in (item for item in cls.body if isinstance(item, ast.FunctionDef)):
                    name = cls.name + "." + function.name
                    if name not in self.batch._CAPABILITIES:
                        continue
                    fields = self.batch._CAPABILITIES[name]["fields"]
                    parameters = [arg.arg for arg in function.args.args]
                    defaults = dict(zip(parameters[len(parameters) - len(function.args.defaults):], function.args.defaults))
                    self.assertEqual(set(fields), set(parameters) - {"operation_id"})
                    for key, (_, default) in fields.items():
                        if key in defaults:
                            self.assertEqual(default, ast.literal_eval(defaults[key]), (name, key))
                        else:
                            self.assertIs(default, self.batch._REQUIRED)
                    checked.add(name)
        self.assertEqual(checked, set(self.batch._CAPABILITIES))

    def test_component_adds_and_set_share_batch_journal_then_compile_once(self):
        commands = [self.create_entry()]
        for name in ("Arm", "View"):
            commands.append({"type": "CubelessComponentTools.add_component_to_blueprint", "params": {
                "blueprint_name": "BP_Test", "component_type": "SceneComponent", "component_name": name, "compile_blueprint": False}})
        commands.extend([{"type": "CubelessComponentTools.set_component_property", "params": {
            "blueprint_name": "BP_Test", "component_name": "View", "property_name": "bVisible", "property_value_json": "false"}},
            {"type": "CubelessComponentTools.get_component_property", "params": {
                "blueprint_name": "BP_Test", "component_name": "View", "property_name": "bVisible"}}, self.compile_entry()])
        result = self.execute(commands)
        self.assertTrue(result["success"], result)
        self.assertEqual(len(self.component_calls), 3)
        self.assertFalse(self.component_calls[0]["compile_blueprint"])
        self.assertFalse(self.component_calls[1]["compile_blueprint"])
        self.assertEqual(self.component_calls[2]["property_value_json"], "false")
        read = result["data"]["batch"]["results"][4]["response"]
        self.assertFalse(read["data"]["property_value"])
        self.assertEqual(read["operation_id"], "test-batch:4")
        self.assertTrue(read["data"]["journaled"])
        self.assertEqual(self.component_read_calls, [("/Game/Blueprints/BP_Test", "View", "bVisible", 10000, 65536)])
        self.assertEqual(sum(call[0] == "compile" for call in self.calls), 1)
        self.assertEqual(len(result["compile"]["entries"]), 1)
        self.assertEqual(len(list(self.state._journal_path("test-batch").parent.glob("*.json"))), 1)

    def test_component_lost_response_forces_stop_even_when_false(self):
        self.component_api.set_component_property = Mock(side_effect=RuntimeError("native response lost"))
        entry = {"type": "CubelessComponentTools.set_component_property", "params": {
            "blueprint_name": "BP_Test", "component_name": "View", "property_name": "bVisible", "property_value_json": "false"}}
        result = self.execute([entry, self.create_entry()], stop=False)
        self.assertTrue(result["data"]["batch"]["forced_stop"])
        self.assertTrue(result["data"]["batch"]["mutation_state_unknown"])
        self.assertEqual(result["data"]["batch"]["not_run"], [1])
        self.assertEqual(self.calls, [])
        self.assertFalse(result["retry"]["automatic_retry"])

    def test_component_verified_noop_is_not_counted_as_engine_mutation(self):
        self.component_api.set_component_property = Mock(return_value={"success": True, "stage": "complete", "data": {},
            "mutation_attempted": False, "change_state_known": True, "changed": False, "postcondition_passed": True,
            "compile_requested": False, "compile_attempted": False, "compiled": None, "save_requested": False, "saved": False})
        result = self.execute([{"type": "CubelessComponentTools.set_component_property", "params": {
            "blueprint_name": "BP_Test", "component_name": "View", "property_name": "bVisible", "property_value_json": "false"}}])
        self.assertTrue(result["success"], result)
        self.assertFalse(result["data"]["batch"]["mutation_attempted"])
        self.assertFalse(result["data"]["batch"]["mutation_performed"])
        self.assertEqual(result["changes"], [])

    def test_named_mesh_batch_preserves_default_identity_and_pre_extension_replay(self):
        entry = {"type": "CubelessComponentTools.set_static_mesh_properties", "params": {
            "blueprint_name": "BP_Test", "component_name": "View"}}
        result = self.execute([entry])
        self.assertTrue(result["success"], result)
        child = result["data"]["batch"]["results"][0]["response"]
        self.assertEqual(child["data"]["operation"], "set_static_mesh_properties")
        self.assertEqual(child["changes"][0]["kind"], "set_static_mesh_properties")
        self.assertEqual(self.component_calls[0], {"blueprint_path": "/Game/Blueprints/BP_Test", "component_name": "View", "static_mesh": "/Engine/BasicShapes/Cube.Cube"})
        self.assertFalse(child["compile"]["attempted"])
        self.assertFalse(child["save"]["saved"])
        previous_args = {"manifest_version": "blueprint-graph-v1", "commands": [{"type": entry["type"],
            "params": {"blueprint_name": "BP_Test", "component_name": "View", "static_mesh": "/Engine/BasicShapes/Cube.Cube"}}], "stop_on_error": True}
        self.state.mutate("execute_batch", previous_args, "pre-r-batch",
            lambda result: result.update(success=True, stage="complete", data={"old_record": True}))
        entry["params"]["material"] = None
        replay = self.execute([entry], operation_id="pre-r-batch")
        self.assertTrue(replay["retry"]["replayed"])
        self.assertTrue(replay["data"]["old_record"])
        self.assertEqual(self.calls, [])
        self.assertEqual(len(self.component_calls), 1)

    def test_named_material_batch_uses_shared_intent_and_forces_stop_on_lost_reply(self):
        entry = {"type": "CubelessComponentTools.set_static_mesh_properties", "params": {
            "blueprint_name": "BP_Test", "component_name": "View", "static_mesh": "", "material": "/Game/M_Test"}}
        result = self.execute([entry])
        self.assertTrue(result["success"], result)
        self.assertEqual(self.component_calls, [{"blueprint_path": "/Game/Blueprints/BP_Test", "component_name": "View",
            "static_mesh": "", "material": "/Game/M_Test.M_Test"}])
        self.assertEqual(len(list(self.state._journal_path("test-batch").parent.glob("*.json"))), 1)
        self.component_api.set_static_mesh_properties = Mock(side_effect=RuntimeError("combined reply lost"))
        failure = self.execute([entry, self.create_entry()], stop=False, operation_id="material-lost-batch")
        self.assertTrue(failure["data"]["batch"]["forced_stop"])
        self.assertEqual(failure["data"]["batch"]["not_run"], [1])
        self.assertTrue(failure["data"]["batch"]["mutation_state_unknown"])
        self.assertEqual(self.calls, [])

    def test_named_physics_batch_defaults_float_inputs_and_uncertain_stop(self):
        entry = {"type": "CubelessComponentTools.set_physics_properties", "params": {
            "blueprint_name": "BP_Test", "component_name": "Body", "mass": 10**12}}
        result = self.execute([entry])
        self.assertTrue(result["success"], result)
        self.assertEqual(self.component_calls[0], {"blueprint_path": "/Game/Blueprints/BP_Test", "component_name": "Body",
            "simulate_physics": True, "gravity_enabled": True, "mass": 1e12, "linear_damping": 0.01, "angular_damping": 0.0})
        child = result["data"]["batch"]["results"][0]["response"]
        self.assertEqual(child["data"]["operation"], "set_physics_properties")
        self.assertFalse(child["compile"]["attempted"])
        self.assertFalse(child["save"]["saved"])
        entry["params"]["mass"] = 1e12
        self.assertTrue(self.execute([entry])["retry"]["replayed"])
        self.assertEqual(len(self.component_calls), 1)
        self.component_api.set_physics_properties = Mock(side_effect=RuntimeError("native physics reply lost"))
        failure = self.execute([entry, self.create_entry()], stop=False, operation_id="physics-lost")
        self.assertTrue(failure["data"]["batch"]["forced_stop"])
        self.assertEqual(failure["data"]["batch"]["not_run"], [1])
        self.assertEqual(self.calls, [])
        self.assertEqual(len(list(self.state._journal_path("test-batch").parent.glob("*.json"))), 2)


if __name__ == "__main__":
